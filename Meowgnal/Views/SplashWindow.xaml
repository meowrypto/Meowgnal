<Window x:Class="Meowgnal.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Width="780" Height="520">

    <Border CornerRadius="14" Background="#131722" BorderBrush="#2A2E39" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <!-- Illustrated winter cat scene -->
            <Image Source="pack://application:,,,/Assets/splash-cat.png" Stretch="UniformToFill"/>

            <!-- Blue info pill (same style as the sample splash) -->
            <Border Background="#2962FF" CornerRadius="0,120,120,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="0,70,0,0" Padding="44,38" Width="440">
                <StackPanel>
                    <TextBlock FontFamily="Trebuchet MS" FontSize="42" Foreground="White">
                        <Run FontWeight="Bold" Text="meow"/><Run FontWeight="Light" Text="gnal"/>
                    </TextBlock>
                    <TextBlock x:Name="VersionText" Text="Version —" FontSize="16"
                               Foreground="White" Opacity="0.95" Margin="0,12,0,0"
                               FontFamily="Trebuchet MS"/>
                    <TextBlock x:Name="UpdateText" Text="Last update: —" FontSize="12"
                               Foreground="White" Opacity="0.75" Margin="0,6,0,0"
                               FontFamily="Trebuchet MS"/>
                    <TextBlock Text="Disciplined crypto signal robot" FontSize="12"
                               Foreground="White" Opacity="0.75" Margin="0,20,0,0"
                               FontFamily="Trebuchet MS"/>
                    <ProgressBar IsIndeterminate="True" Width="280" Height="4" Margin="0,24,0,0"
                                 Foreground="White" Background="#5B8CFF" BorderThickness="0"
                                 HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>