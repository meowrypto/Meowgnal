<Window x:Class="Meowgnal.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight">
    <Border Background="#131722" CornerRadius="10" BorderBrush="#2A2E39" BorderThickness="1"
            Width="380" Padding="36,30">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="🐱" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Meowgnal" FontSize="26" FontWeight="Bold" Foreground="#D1D4DC"
                       HorizontalAlignment="Center" FontFamily="Trebuchet MS"/>
            <TextBlock Text="Disciplined crypto signal robot" FontSize="12" Foreground="#787B86"
                       HorizontalAlignment="Center" Margin="0,4,0,18"/>
            <TextBlock x:Name="VersionText" Text="Version —" FontSize="11" Foreground="#B2B5BE"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="UpdateText" Text="Last update: —" FontSize="11" Foreground="#787B86"
                       HorizontalAlignment="Center" Margin="0,2,0,16"/>
            <ProgressBar IsIndeterminate="True" Width="220" Height="4" Foreground="#2962FF"
                         Background="#1E222D" BorderThickness="0"/>
        </StackPanel>
    </Border>
</Window>