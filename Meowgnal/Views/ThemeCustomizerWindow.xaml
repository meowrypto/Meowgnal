<Window x:Class="Meowgnal.Views.ThemeCustomizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Theme" Height="560" Width="470"
        Background="#131722" WindowStartupLocation="CenterOwner"
        FontFamily="Trebuchet MS" FontSize="12" ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#1E222D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2A2E39"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#D1D4DC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#787B86"/>
        <SolidColorBrush x:Key="Accent" Color="#2962FF"/>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#2A2E39" BorderThickness="1" CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2962FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HexBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="#D1D4DC"/>
            <Setter Property="BorderBrush" Value="#2A2E39"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#D1D4DC"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Custom Theme" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Click a swatch or type a hex code, then Save and apply."
                       Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Rectangle x:Name="SwatchBackground" Width="34" Height="24" RadiusX="4" RadiusY="4"
                               Stroke="#2A2E39" StrokeThickness="1"/>
                    <TextBlock Text="Background" Width="90" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="HexBackground" Style="{StaticResource HexBox}" Width="90"
                             Tag="bg" TextChanged="Hex_TextChanged"/>
                </StackPanel>
                <WrapPanel x:Name="PaletteBackground" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Rectangle x:Name="SwatchPanel" Width="34" Height="24" RadiusX="4" RadiusY="4"
                               Stroke="#2A2E39" StrokeThickness="1"/>
                    <TextBlock Text="Panels" Width="90" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="HexPanel" Style="{StaticResource HexBox}" Width="90"
                             Tag="panel" TextChanged="Hex_TextChanged"/>
                </StackPanel>
                <WrapPanel x:Name="PalettePanel" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Rectangle x:Name="SwatchBorder" Width="34" Height="24" RadiusX="4" RadiusY="4"
                               Stroke="#2A2E39" StrokeThickness="1"/>
                    <TextBlock Text="Borders" Width="90" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="HexBorder" Style="{StaticResource HexBox}" Width="90"
                             Tag="border" TextChanged="Hex_TextChanged"/>
                </StackPanel>
                <WrapPanel x:Name="PaletteBorder" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Rectangle x:Name="SwatchText" Width="34" Height="24" RadiusX="4" RadiusY="4"
                               Stroke="#2A2E39" StrokeThickness="1"/>
                    <TextBlock Text="Text" Width="90" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="HexText" Style="{StaticResource HexBox}" Width="90"
                             Tag="text" TextChanged="Hex_TextChanged"/>
                </StackPanel>
                <WrapPanel x:Name="PaletteText" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Rectangle x:Name="SwatchAccent" Width="34" Height="24" RadiusX="4" RadiusY="4"
                               Stroke="#2A2E39" StrokeThickness="1"/>
                    <TextBlock Text="Accent" Width="90" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBox x:Name="HexAccent" Style="{StaticResource HexBox}" Width="90"
                             Tag="accent" TextChanged="Hex_TextChanged"/>
                </StackPanel>
                <WrapPanel x:Name="PaletteAccent" Margin="0,0,0,12"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reset to dark" Style="{StaticResource SecondaryButton}" Padding="12,6"
                    Margin="0,0,8,0" Click="Reset_Click"/>
            <Button Content="Save and apply" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>