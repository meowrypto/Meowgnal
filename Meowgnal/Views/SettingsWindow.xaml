<Window x:Class="Meowgnal.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="620" Width="680"
        Background="#131722" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#1E222D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2A2E39"/>
        <SolidColorBrush x:Key="TextColor" Color="#D1D4DC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#787B86"/>
        <SolidColorBrush x:Key="AccentColor" Color="#2962FF"/>
        <SolidColorBrush x:Key="DangerColor" Color="#F23645"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#089981"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2E39"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2E39"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerColor}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Border" Width="16" Height="16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Background="Transparent" CornerRadius="2" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Stroke="White" StrokeThickness="2" Data="M 2 8 L 6 12 L 14 4" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,15,0,0">
                <RadioButton x:Name="NavDataSources" Content="Data sources" GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavApiKeys" Content="Exchange API keys" GroupName="Nav" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavAccuracy" Content="Accuracy filters" GroupName="Nav" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavPaperTrading" Content="Paper trading" GroupName="Nav" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavNotifications" Content="Notifications" GroupName="Nav" Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="25">
                <StackPanel x:Name="PanelDataSources">
                    <TextBlock Text="Default candle/price source for new strategies" Foreground="{StaticResource TextMuted}" Margin="0,0,0,15" FontSize="13"/>
                    <RadioButton x:Name="SourceBinance" Content="Binance" GroupName="Source" Margin="0,0,0,10"/>
                    <RadioButton x:Name="SourceHyperliquid" Content="Hyperliquid" GroupName="Source" Margin="0,0,0,15"/>
                    <TextBlock Text="Both sources stay connected in the background — this only sets the default shown on new strategies."
                               Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel x:Name="PanelApiKeys" Visibility="Collapsed">
                    <Border Background="#2A2215" CornerRadius="4" Padding="12" Margin="0,0,0,20">
                        <TextBlock Text="⚠️ Only ever provide a Read-Only API key here. Never a key with trade or withdrawal permission."
                                   Foreground="#FFB74D" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                    <TextBlock Text="Binance API key" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <TextBox x:Name="ApiKeyBox" Margin="0,0,0,15"/>
                    <TextBlock Text="Binance API secret" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="ApiSecretBox" Margin="0,0,0,15"/>
                </StackPanel>

                <StackPanel x:Name="PanelAccuracy" Visibility="Collapsed">
                    <TextBlock Text="Accuracy Engine" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="These filters run on every live signal before it reaches the dashboard. They reduce noise but may filter out valid trades."
                               Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <Border Background="#1E222D" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="AccuracyClosedCandleCheck" Content="Closed candle only" Margin="0,0,0,10"/>
                            <TextBlock Text="Ignore signals that appear on the currently forming (unconfirmed) candle."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E222D" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="AccuracyMtfCheck" Content="Multi-timeframe trend filter" Margin="0,0,0,10"/>
                            <TextBlock Text="Only show long entries when higher-timeframe trend is bullish, and shorts when bearish."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E222D" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="AccuracyVolumeCheck" Content="Volume spike filter" Margin="0,0,0,10"
                                      Checked="AccuracyVolumeCheck_Changed" Unchecked="AccuracyVolumeCheck_Changed"/>
                            <TextBlock Text="Require the signal candle's volume to be at least N× the 20-period average."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" x:Name="VolumeMultiplierPanel" Visibility="Collapsed">
                                <TextBlock Text="Volume multiplier ×" Width="140" VerticalAlignment="Center"/>
                                <TextBox x:Name="AccuracyVolumeMultiplierBox" Width="80"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E222D" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="AccuracyRegimeCheck" Content="Market regime filter" Margin="0,0,0,10"/>
                            <TextBlock Text="Suppress signals during extremely low-volatility regimes (bottom 20% ATR)."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#152230" CornerRadius="4" Padding="12">
                        <TextBlock Text="💡 Tip: Start with only 'Closed candle only' enabled. Add more filters one at a time and compare backtest results."
                                   Foreground="#64B5F6" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PanelPaperTrading" Visibility="Collapsed">
                    <TextBlock Text="Paper Trading Configuration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <Border Background="#1E222D" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="💰 Account Setup" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Starting balance (USDT)" Width="200" VerticalAlignment="Center"/>
                                <TextBox x:Name="PaperBalanceBox" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Default leverage" Width="200" VerticalAlignment="Center"/>
                                <TextBox x:Name="PaperLeverageBox" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Taker fee %" Width="200" VerticalAlignment="Center"/>
                                <TextBox x:Name="PaperTakerFeeBox" Width="120"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E222D" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="📏 Position Sizing" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <CheckBox x:Name="PaperUseRiskSizingCheck" Content="Use risk-based sizing (professional standard)" Margin="0,0,0,12"/>
                            <StackPanel x:Name="RiskSizingPanel" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Risk per trade %" Width="200" VerticalAlignment="Center"/>
                                <TextBox x:Name="PaperRiskPercentBox" Width="120"/>
                            </StackPanel>
                            <StackPanel x:Name="FixedSizePanel" Orientation="Horizontal">
                                <TextBlock Text="Position size % of balance" Width="200" VerticalAlignment="Center"/>
                                <TextBox x:Name="PaperPositionSizeBox" Width="120"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E222D" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="🎯 Default SL/TP (for signals without explicit targets)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Stop-loss %" Width="200" VerticalAlignment="Center" Foreground="{StaticResource DangerColor}"/>
                                <TextBox x:Name="PaperDefaultSLBox" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Take-profit %" Width="200" VerticalAlignment="Center" Foreground="{StaticResource SuccessColor}"/>
                                <TextBox x:Name="PaperDefaultTPBox" Width="120"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E222D" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="🛡️ Risk Management" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Max daily loss % (0 = disabled)" Width="200" VerticalAlignment="Center"/>
                                <TextBox x:Name="PaperMaxDailyLossBox" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Max open positions (0 = unlimited)" Width="200" VerticalAlignment="Center"/>
                                <TextBox x:Name="PaperMaxPositionsBox" Width="120"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#2A1520" CornerRadius="6" Padding="16">
                        <StackPanel>
                            <TextBlock Text="⚠️ Danger Zone" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DangerColor}" Margin="0,0,0,8"/>
                            <TextBlock Text="Reset paper account to starting balance. This will close all open positions and clear trade history."
                                       Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Content="Reset Paper Account" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" Click="ResetPaperAccount_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PanelNotifications" Visibility="Collapsed">
                    <CheckBox x:Name="ToastCheck" Content="Windows toast notification on new signal" Margin="0,0,0,12"/>
                    <CheckBox x:Name="SoundCheck" Content="Play alert sound on new signal" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Check for new signals every" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="IntervalCombo" Width="140">
                            <ComboBoxItem Content="30 seconds" Tag="30"/>
                            <ComboBoxItem Content="1 minute" Tag="60"/>
                            <ComboBoxItem Content="5 minutes" Tag="300"/>
                            <ComboBoxItem Content="15 minutes" Tag="900"/>
                        </ComboBox>
                    </StackPanel>
                    <Button x:Name="TestNotificationButton" Content="Send test notification" HorizontalAlignment="Left" Click="TestNotificationButton_Click"/>
                    <TextBlock Text="More channels (Telegram, email) are planned for a future update."
                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,15,0,0"/>
                </StackPanel>

                
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>