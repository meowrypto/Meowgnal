<Window x:Class="Meowgnal.Views.BacktestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Backtest" Height="640" Width="760"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource ColorBackground}"/>
        <SolidColorBrush x:Key="PanelBg" Color="{DynamicResource ColorPanel}"/>
        <SolidColorBrush x:Key="BorderColor" Color="{DynamicResource ColorBorder}"/>
        <SolidColorBrush x:Key="TextColor" Color="{DynamicResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource ColorTextMuted}"/>
        <SolidColorBrush x:Key="AccentColor" Color="{DynamicResource ColorAccent}"/>
        <SolidColorBrush x:Key="DangerColor" Color="{DynamicResource ColorDown}"/>
        <SolidColorBrush x:Key="Up" Color="{DynamicResource ColorUp}"/>
        <SolidColorBrush x:Key="DangerBg" Color="#3D1A1A"/>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#363A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TertiaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextColor}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="RowBackground" Value="{StaticResource PanelBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Border" Width="14" Height="14" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Background="Transparent" CornerRadius="2" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Stroke="White" StrokeThickness="2" Data="M 2 7 L 5 10 L 11 3" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBg}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="—" Width="46" Height="32" Style="{StaticResource WindowControlButton}" Click="Minimize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaximizeButton" Content="⛶" Width="46" Height="32" Style="{StaticResource WindowControlButton}" Click="Maximize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Width="46" Height="32" Style="{StaticResource CloseButton}" Click="Close_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                    <TextBlock x:Name="TitleText" Text="Backtest Report" Foreground="{DynamicResource TextColor}"
                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </DockPanel>
            </Border>

            <!-- Main content -->
            <DockPanel Grid.Row="1" Margin="14">
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Strategy" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="StrategyCombo" Width="160" DisplayMemberPath="Name"/>
                        <TextBlock Text="Balance" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                        <TextBox x:Name="BalanceBox" Text="10000" Width="70"/>
                        <TextBlock Text="Fee %" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                        <TextBox x:Name="FeeBox" Text="0.1" Width="45"/>
                        <TextBlock Text="Slip %" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                        <TextBox x:Name="SlippageBox" Text="0.05" Width="45"/>

                        <CheckBox x:Name="WalkForwardCheck" Content="Walk-Forward" Margin="16,0,8,0" Checked="WalkForwardCheck_Changed" Unchecked="WalkForwardCheck_Changed"/>
                        <TextBlock x:Name="WindowsLabel" Text="Win:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed"/>
                        <TextBox x:Name="WindowsBox" Text="5" Width="30" Visibility="Collapsed"/>
                        <TextBlock x:Name="OosLabel" Text="OOS %:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,4,0" Visibility="Collapsed"/>
                        <TextBox x:Name="OosPercentBox" Text="20" Width="30" Visibility="Collapsed"/>

                        <Button Content="▶ Run" Padding="16,6" Margin="16,0,0,0" Click="Run_Click"/>
                        <Button Content="📉 Risk of Ruin" Padding="16,6" Margin="8,0,0,0"
                                Style="{StaticResource TertiaryButton}" Click="RiskOfRuin_Click"/>
                        <Button Content="🎲 Monte Carlo" Padding="16,6" Margin="8,0,0,0"
                                Style="{StaticResource TertiaryButton}" Click="MonteCarlo_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource TextMuted}"
                           Text="⚠️ Past backtest results don't guarantee future performance." />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border x:Name="OverfitWarning" Background="{StaticResource DangerBg}" CornerRadius="6" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="⚠️ OVERFIT DETECTED" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource DangerColor}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="OverfitText" Foreground="{StaticResource TextColor}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SampleSizeWarningBanner" Background="#3D1A1A" CornerRadius="6" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="SampleSizeWarningTitle" FontWeight="SemiBold" FontSize="13" Foreground="#FF6B6B" Margin="0,0,0,4"/>
                                <TextBlock x:Name="SampleSizeWarningText" Foreground="#F5E5E5" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SampleSizeReliableBanner" Background="#1E3A2A" CornerRadius="6" Padding="10" Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBlock Foreground="{StaticResource Up}" FontSize="12">
                                <Run Text="✓"/> <Run x:Name="SampleSizeReliableText" Text=""/>
                            </TextBlock>
                        </Border>

                        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                            <lvc:CartesianChart x:Name="EquityChart" Height="220"/>
                        </Border>

                        <TextBlock Text="In-Sample Results (Training Data)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                        <UniformGrid Columns="5" Margin="0,0,0,18">
                            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Win rate" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="WinRateText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Avg R:R" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="AvgRRText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Max drawdown" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="DrawdownText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DangerColor}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Total trades" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="TradesText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="Balance" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="BalanceResultText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Up}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14,10" Margin="0,10,10,0">
                                <StackPanel>
                                    <TextBlock Text="Sharpe ratio" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="SharpeText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14,10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Sortino ratio" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="SortinoText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock x:Name="OosHeader" Text="Out-of-Sample Results (Unseen Data)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <UniformGrid x:Name="OosCards" Columns="5" Margin="0,0,0,18" Visibility="Collapsed">
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="OOS Win rate" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="OosWinRateText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="OOS Avg R:R" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="OosAvgRRText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="OOS Max DD" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="OosDrawdownText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource DangerColor}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="OOS Trades" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="OosTradesText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="14,10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="OOS Balance" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="OosBalanceResultText" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Up}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="14,10" Margin="0,10,10,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="OOS Sharpe" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="OosSharpeText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="14,10" Margin="0,10,0,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="OOS Sortino" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock x:Name="OosSortinoText" Text="—" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="Trade log" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <DataGrid x:Name="TradesGrid" AutoGenerateColumns="False" Height="200">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="🔍" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="🔍" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand">
                                                <TextBlock.ToolTip>
                                                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="10" MaxWidth="420">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource SuccessColor}" Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding EntryExplanation}"/>
                                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource DangerColor}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding ExitExplanation}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Entry time" Binding="{Binding EntryTime}" Width="130"/>
                                <DataGridTextColumn Header="Entry" Binding="{Binding EntryPrice, StringFormat=N2}" Width="90"/>
                                <DataGridTextColumn Header="Exit time" Binding="{Binding ExitTime}" Width="130"/>
                                <DataGridTextColumn Header="Exit" Binding="{Binding ExitPrice, StringFormat=N2}" Width="90"/>
                                <DataGridTextColumn Header="Reason" Binding="{Binding ExitReason}" Width="80"/>
                                <DataGridTextColumn Header="PnL %" Binding="{Binding PnLPercent, StringFormat=N2}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Monthly performance" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,8"/>
                        <DataGrid x:Name="MonthlyGrid" AutoGenerateColumns="False" Height="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Month" Binding="{Binding MonthLabel}" Width="120"/>
                                <DataGridTextColumn Header="Trades" Binding="{Binding TradeCount}" Width="90"/>
                                <DataGridTextColumn Header="Net PnL" Binding="{Binding NetPnL, StringFormat=N2}" Width="120"/>
                                <DataGridTextColumn Header="Win rate %" Binding="{Binding WinRatePercent, StringFormat=N1}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>