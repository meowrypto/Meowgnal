<Window x:Class="Meowgnal.Views.BacktestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Backtest" Height="640" Width="760"
        Background="#131722" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- TradingView Dark Palette -->
        <SolidColorBrush x:Key="PanelBg" Color="#1E222D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2A2E39"/>
        <SolidColorBrush x:Key="TextColor" Color="#D1D4DC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#787B86"/>
        <SolidColorBrush x:Key="AccentColor" Color="#2962FF"/>

        <!-- Base Text Style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="RowBackground" Value="{StaticResource PanelBg}"/>
            <Setter Property="AlternatingRowBackground" Value="#131722"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#131722"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Config bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Strategy" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="StrategyCombo" Width="190" DisplayMemberPath="Name"/>
                <TextBlock Text="Starting balance" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox x:Name="BalanceBox" Text="10000" Width="80"/>
                <TextBlock Text="Fee %" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox x:Name="FeeBox" Text="0.1" Width="60"/>
                <TextBlock Text="Slippage %" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox x:Name="SlippageBox" Text="0.05" Width="60"/>
                <Button Content="▶ Run Backtest" Padding="16,6" Margin="16,0,0,0" Click="Run_Click"/>
            </StackPanel>
        </Border>

        <!-- Disclaimer -->
        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource TextMuted}"
                   Text="⚠️ Past backtest results don't guarantee future performance." />

        <!-- Stats + chart + trade log -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                    <lvc:CartesianChart x:Name="EquityChart" Height="240"/>
                </Border>

                <!-- Stats cards -->
                <UniformGrid Columns="5" Margin="0,0,0,18">
                    <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Win rate" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock x:Name="WinRateText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Avg R:R" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock x:Name="AvgRRText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Max drawdown" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock x:Name="DrawdownText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#F23645" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Total trades" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock x:Name="TradesText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="Balance" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock x:Name="BalanceResultText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#089981" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Trade log" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                <DataGrid x:Name="TradesGrid" AutoGenerateColumns="False" Height="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Entry time" Binding="{Binding EntryTime}" Width="130"/>
                        <DataGridTextColumn Header="Entry" Binding="{Binding EntryPrice, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Exit time" Binding="{Binding ExitTime}" Width="130"/>
                        <DataGridTextColumn Header="Exit" Binding="{Binding ExitPrice, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding ExitReason}" Width="80"/>
                        <DataGridTextColumn Header="PnL %" Binding="{Binding PnLPercent, StringFormat=N2}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>