<Window x:Class="Meowgnal.Views.BacktestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Backtest" Height="640" Width="760"
        Background="#0F1117">

    <Window.Resources>
        <SolidColorBrush x:Key="TextMuted" Color="#8A8F9C"/>
        <SolidColorBrush x:Key="PanelBg" Color="#161A23"/>
        <SolidColorBrush x:Key="BorderColor" Color="#262B38"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Config bar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Strategy" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="StrategyCombo" Width="180" DisplayMemberPath="Name"/>
            <TextBlock Text="Starting balance" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="14,0,6,0"/>
            <TextBox x:Name="BalanceBox" Text="10000" Width="70"/>
            <TextBlock Text="Fee %" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="14,0,6,0"/>
            <TextBox x:Name="FeeBox" Text="0.1" Width="50"/>
            <TextBlock Text="Slippage %" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="14,0,6,0"/>
            <TextBox x:Name="SlippageBox" Text="0.05" Width="50"/>
            <Button Content="Run" Padding="14,4" Margin="14,0,0,0" Click="Run_Click"/>
        </StackPanel>

        <!-- Disclaimer -->
        <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource TextMuted}"
                   Text="Past backtest results don't guarantee future performance." />

        <!-- Stats + chart + trade log -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <lvc:CartesianChart x:Name="EquityChart" Height="220" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Win rate" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock x:Name="WinRateText" Text="—" FontSize="16" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Avg R:R" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock x:Name="AvgRRText" Text="—" FontSize="16" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Max drawdown" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock x:Name="DrawdownText" Text="—" FontSize="16" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Total trades" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock x:Name="TradesText" Text="—" FontSize="16" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="Balance" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock x:Name="BalanceResultText" Text="—" FontSize="16" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="Trade log" FontWeight="Bold" Margin="0,0,0,6"/>
                <DataGrid x:Name="TradesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="{StaticResource PanelBg}" Foreground="White" RowBackground="{StaticResource PanelBg}"
                          BorderBrush="{StaticResource BorderColor}" GridLinesVisibility="Horizontal" Height="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Entry time" Binding="{Binding EntryTime}" Width="130"/>
                        <DataGridTextColumn Header="Entry" Binding="{Binding EntryPrice, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Exit time" Binding="{Binding ExitTime}" Width="130"/>
                        <DataGridTextColumn Header="Exit" Binding="{Binding ExitPrice, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding ExitReason}" Width="80"/>
                        <DataGridTextColumn Header="PnL %" Binding="{Binding PnLPercent, StringFormat=N2}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>