<Window x:Class="Meowgnal.Views.DrawingPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drawing Properties" Height="600" Width="420"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Trebuchet MS" FontSize="12" ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource ColorBackground}"/>
        <SolidColorBrush x:Key="PanelBg" Color="{DynamicResource ColorPanel}"/>
        <SolidColorBrush x:Key="BorderColor" Color="{DynamicResource ColorBorder}"/>
        <SolidColorBrush x:Key="TextColor" Color="{DynamicResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource ColorTextMuted}"/>
        <SolidColorBrush x:Key="AccentColor" Color="{DynamicResource ColorAccent}"/>
        <SolidColorBrush x:Key="DangerColor" Color="{DynamicResource ColorDown}"/>
        <SolidColorBrush x:Key="SuccessColor" Color="{DynamicResource ColorUp}"/>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#363A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextColor}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="—" Width="46" Height="32" Style="{StaticResource WindowControlButton}" 
                                Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaximizeButton" Content="⛶" Width="46" Height="32" 
                                Style="{StaticResource WindowControlButton}" Click="Maximize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Width="46" Height="32" Style="{StaticResource CloseButton}" 
                                Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                    <TextBlock Text="Drawing Properties" Foreground="{StaticResource TextColor}"
                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </DockPanel>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="🎨 Drawing Properties" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource TextColor}" Margin="0,0,0,14"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Style section -->
                        <TextBlock Text="STYLE" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <TextBlock Text="Label" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="LabelBox" Margin="0,0,0,10"/>

                        <TextBlock Text="Color" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Style="{StaticResource SwatchButton}" Tag="#2962FF" Background="#2962FF" Click="Swatch_Click"/>
                            <Button Style="{StaticResource SwatchButton}" Tag="#089981" Background="#089981" Click="Swatch_Click"/>
                            <Button Style="{StaticResource SwatchButton}" Tag="#F23645" Background="#F23645" Click="Swatch_Click"/>
                            <Button Style="{StaticResource SwatchButton}" Tag="#FF9800" Background="#FF9800" Click="Swatch_Click"/>
                            <Button Style="{StaticResource SwatchButton}" Tag="#9C27B0" Background="#9C27B0" Click="Swatch_Click"/>
                            <Button Style="{StaticResource SwatchButton}" Tag="#D1D4DC" Background="#D1D4DC" Click="Swatch_Click"/>
                            <Rectangle x:Name="PreviewRect" Width="26" Height="26" RadiusX="4" RadiusY="4"
                                       Stroke="{StaticResource BorderColor}" StrokeThickness="1" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBox x:Name="HexBox" Margin="0,0,0,10" TextChanged="HexBox_TextChanged"/>

                        <TextBlock Text="Thickness" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="WidthCombo" Margin="0,0,0,10"/>

                        <TextBlock Text="Line style" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="StyleCombo" Margin="0,0,0,10"/>

                        <!-- Text section (visible only for Text/Note/Sticker) -->
                        <StackPanel x:Name="TextSection" Visibility="Collapsed">
                            <TextBlock Text="TEXT" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,6"/>
                            <TextBlock Text="Font" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FontCombo" Margin="0,0,0,10"/>
                            <TextBlock Text="Size" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FontSizeCombo" Margin="0,0,0,10"/>
                        </StackPanel>

                        <!-- Gann section (visible only for Gann Fan) -->
                        <StackPanel x:Name="GannSection" Visibility="Collapsed">
                            <TextBlock Text="GANN RATIOS" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,6"/>
                            <TextBlock Text="Enter ratios separated by commas"
                                    Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                            <TextBlock Text="Example: 0.25, 0.5, 1, 2, 4"
                                    Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,4" FontStyle="Italic"/>
                            <TextBox x:Name="GannRatiosBox" Margin="0,0,0,10"/>
                        </StackPanel>
                        <!-- Channel section (visible for channel tools) -->
                        <StackPanel x:Name="ChannelSection" Visibility="Collapsed">
                            <TextBlock Text="CHANNEL SETTINGS" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,6"/>
                            <CheckBox x:Name="FillBgCheck" Content="Fill background between lines" Checked="FillBgCheck_Changed" Unchecked="FillBgCheck_Changed"/>
                            <StackPanel x:Name="FillOpacityPanel" Orientation="Horizontal" Margin="24,0,0,8">
                                <TextBlock Text="Opacity:" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="FillOpacitySlider" Width="120" Minimum="0.05" Maximum="0.8" Value="0.15" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FillOpacityLabel" Text="15%" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <!-- ParallelChannel: Median line -->
                            <StackPanel x:Name="MedianSection" Visibility="Collapsed">
                                <CheckBox x:Name="MedianCheck" Content="Show median line" Margin="0,4,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="24,0,0,8">
                                    <TextBlock Text="Median color:" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#FF9800" Background="#FF9800" Click="MedianColor_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#2962FF" Background="#2962FF" Click="MedianColor_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#089981" Background="#089981" Click="MedianColor_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#D1D4DC" Background="#D1D4DC" Click="MedianColor_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- RegressionTrend: StdDev multiplier -->
                            <StackPanel x:Name="StdDevSection" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <TextBlock Text="Std Dev multiplier (1-3):" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="StdDevCombo" Width="60"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- DisjointChannel: Second line color -->
                            <StackPanel x:Name="SecondColorSection" Visibility="Collapsed">
                                <TextBlock Text="Second line color:" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Style="{StaticResource SwatchButton}" Tag="#2962FF" Background="#2962FF" Click="SecondColor_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#F23645" Background="#F23645" Click="SecondColor_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#089981" Background="#089981" Click="SecondColor_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#FF9800" Background="#FF9800" Click="SecondColor_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#9C27B0" Background="#9C27B0" Click="SecondColor_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#D1D4DC" Background="#D1D4DC" Click="SecondColor_Click"/>
                                    <Rectangle x:Name="SecondColorPreview" Width="26" Height="26" RadiusX="4" RadiusY="4"
                                            Stroke="{StaticResource BorderColor}" StrokeThickness="1" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <!-- Coordinates section -->
                        <TextBlock Text="COORDINATES" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,6"/>
                        <StackPanel x:Name="PointsPanel"/>

                        <!-- Visibility section -->
                        <TextBlock Text="VISIBILITY" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <CheckBox x:Name="AlertCheck" Content="🔔 Alert on price cross (Toast + sound)"/>
                        <CheckBox x:Name="LockedCheck" Content="🔒 Locked (eraser cannot delete)"/>
                        <CheckBox x:Name="HiddenCheck" Content="🚫 Hidden (do not show on chart)"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="14,6"
                            Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Padding="16,6" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>