<Window x:Class="Meowgnal.Views.DrawingPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drawing Properties" Height="340" Width="380"
        Background="#131722" WindowStartupLocation="CenterOwner"
        FontFamily="Trebuchet MS" FontSize="12" ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#1E222D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2A2E39"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#D1D4DC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#787B86"/>
        <SolidColorBrush x:Key="Accent" Color="#2962FF"/>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#2A2E39" BorderThickness="1" CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2962FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="#D1D4DC"/>
            <Setter Property="BorderBrush" Value="#2A2E39"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#D1D4DC"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D1D4DC"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="✏️ Drawing Properties" FontSize="15" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Label" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="LabelBox" Margin="0,0,0,12"/>

            <TextBlock Text="Color" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Style="{StaticResource SwatchButton}" Tag="#2962FF" Background="#2962FF" Click="Swatch_Click"/>
                <Button Style="{StaticResource SwatchButton}" Tag="#089981" Background="#089981" Click="Swatch_Click"/>
                <Button Style="{StaticResource SwatchButton}" Tag="#F23645" Background="#F23645" Click="Swatch_Click"/>
                <Button Style="{StaticResource SwatchButton}" Tag="#FF9800" Background="#FF9800" Click="Swatch_Click"/>
                <Button Style="{StaticResource SwatchButton}" Tag="#9C27B0" Background="#9C27B0" Click="Swatch_Click"/>
                <Button Style="{StaticResource SwatchButton}" Tag="#D1D4DC" Background="#D1D4DC" Click="Swatch_Click"/>
                <Rectangle x:Name="PreviewRect" Width="26" Height="26" RadiusX="4" RadiusY="4"
                           Stroke="#2A2E39" StrokeThickness="1" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBox x:Name="HexBox" Margin="0,0,0,12" TextChanged="HexBox_TextChanged"/>

            <CheckBox x:Name="AlertCheck" Content="🔔 Alert on price cross (Toast + sound)"/>
            <CheckBox x:Name="LockedCheck" Content="🔒 Locked (eraser cannot delete)"/>
            <CheckBox x:Name="HiddenCheck" Content="🚫 Hidden (do not show on chart)"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="14,6"
                    Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Padding="16,6" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>