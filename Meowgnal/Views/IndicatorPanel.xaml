<UserControl x:Class="Meowgnal.Views.IndicatorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320"
             Background="{DynamicResource BgPanel}"
             FontFamily="Trebuchet MS" FontSize="12">

    <UserControl.Resources>

        <!-- Search box (uses app-level theme brushes only) -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CategoryHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderLine}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        <!-- One indicator row: star + name + description -->
        <DataTemplate x:Key="IndicatorRowTemplate">
            <Border Background="Transparent" Cursor="Hand" Padding="6,6" MouseLeftButtonDown="Row_Click" Tag="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource StarButton}" Content="{Binding FavIcon}"
                            Tag="{Binding}" Click="Star_Click" ToolTip="Toggle favorite"/>
                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMuted}" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Live search -->
            <TextBox x:Name="SearchBox" Grid.Row="0" Style="{StaticResource SearchBox}"
                     Margin="10" TextChanged="SearchBox_TextChanged"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Favorites -->
                    <Button Style="{StaticResource CategoryHeaderButton}" Click="FavoritesHeader_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FavoritesArrow" Text="▾" Foreground="{DynamicResource TextMuted}" Width="14"/>
                            <TextBlock Text="⭐ Favorites" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="FavoritesBody">
                        <TextBlock x:Name="FavoritesEmptyHint" Text="No favorites yet — click the ☆ next to an indicator."
                                   Foreground="{DynamicResource TextMuted}" FontSize="10"
                                   Margin="24,0,10,8" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="FavoritesList" ItemTemplate="{StaticResource IndicatorRowTemplate}"/>
                    </StackPanel>

                    <!-- Technical -->
                    <Button Style="{StaticResource CategoryHeaderButton}" Click="TechnicalHeader_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TechnicalArrow" Text="▾" Foreground="{DynamicResource TextMuted}" Width="14"/>
                            <TextBlock Text="📈 Technical" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="TechnicalBody">
                        <ItemsControl x:Name="TechnicalList" ItemTemplate="{StaticResource IndicatorRowTemplate}"/>
                    </StackPanel>

                    <!-- Fundamental (empty for now) -->
                    <Button Style="{StaticResource CategoryHeaderButton}" Click="FundamentalHeader_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FundamentalArrow" Text="▸" Foreground="{DynamicResource TextMuted}" Width="14"/>
                            <TextBlock Text="📊 Fundamental" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="FundamentalBody" Visibility="Collapsed">
                        <TextBlock Text="Coming soon" Foreground="{DynamicResource TextMuted}" FontSize="10"
                                   Margin="24,0,10,8"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>