<Window x:Class="Meowgnal.Views.PortfolioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-strategy Portfolio" Height="600" Width="560"
        Background="{DynamicResource BackgroundBrush}" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Theme brushes: colors come from ThemeService at app level (live switching) -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource ColorBackground}"/>
        <SolidColorBrush x:Key="BgPanel" Color="{DynamicResource ColorPanel}"/>
        <SolidColorBrush x:Key="BorderLine" Color="{DynamicResource ColorBorder}"/>
        <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="Accent" Color="{DynamicResource ColorAccent}"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <Border Padding="20">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="🧩 Multi-strategy Portfolio"
                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,20">
                Control which strategies are allowed to auto-trade on your Paper account,
                and limit how many positions can be open at once.
                Leaving the list empty means "all strategies allowed" (default behavior).
            </TextBlock>

            <!-- Limits -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" CornerRadius="6"
                    Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Position limits" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Max total open positions (0 = unlimited)"
                                   Width="320" VerticalAlignment="Center"/>
                        <TextBox x:Name="MaxTotalBox" Width="80"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Max open positions per strategy (0 = unlimited)"
                                   Width="320" VerticalAlignment="Center"/>
                        <TextBox x:Name="MaxPerStrategyBox" Width="80"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Strategies -->
            <TextBlock DockPanel.Dock="Top" Text="Approved strategies" FontWeight="SemiBold"
                       FontSize="14" Margin="0,0,0,8"/>

            <Border DockPanel.Dock="Bottom" Padding="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save" Click="Save_Click"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StrategiesPanel"/>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</Window>