<Window x:Class="Meowgnal.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Meowgnal" Width="470" SizeToContent="Height"
        Background="#131722" WindowStartupLocation="CenterScreen"
        FontFamily="Trebuchet MS" FontSize="12" ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#1E222D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2A2E39"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#D1D4DC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B2B5BE"/>
        <SolidColorBrush x:Key="TextMuted" Color="#787B86"/>
        <SolidColorBrush x:Key="Accent" Color="#2962FF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E222D"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28">
        <TextBlock Text="🐱 Welcome to Meowgnal" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Text="How would you like to start?" Foreground="{StaticResource TextMuted}"
                   FontSize="12" Margin="0,0,0,18"/>

        <!-- Local profile -->
        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Create a local profile" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="Stored only on this PC (encrypted). No email, no cloud."
                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Your name" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox" Text="Trader" Width="180"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Avatar" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AvatarCombo" Width="90" SelectedIndex="0">
                            <ComboBoxItem Content="🐱"/>
                            <ComboBoxItem Content="🦊"/>
                            <ComboBoxItem Content="🐼"/>
                            <ComboBoxItem Content="🦁"/>
                            <ComboBoxItem Content="🐸"/>
                            <ComboBoxItem Content="🚀"/>
                            <ComboBoxItem Content="🌙"/>
                            <ComboBoxItem Content="⚡"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <Button Content="Start with my profile" Style="{StaticResource PrimaryButton}"
                        Padding="14,7" HorizontalAlignment="Left" Click="CreateProfile_Click"/>
            </StackPanel>
        </Border>

        <TextBlock Text="— or —" Foreground="{StaticResource TextMuted}" FontSize="11"
                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <!-- Guest demo -->
        <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="16">
            <StackPanel>
                <TextBlock Text="Continue as guest" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="14-day demo, locked to this PC. You can activate a license later from the profile menu."
                           Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button Content="Continue as guest" Style="{StaticResource SecondaryButton}"
                        Padding="14,7" HorizontalAlignment="Left" Click="Guest_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>