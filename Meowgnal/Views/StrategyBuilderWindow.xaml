<Window x:Class="Meowgnal.Views.StrategyBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Meowgnal.Views"
        Title="Strategy Builder" Height="720" Width="760"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Trebuchet MS" FontSize="12">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource ColorBackground}"/>
        <SolidColorBrush x:Key="BgPanel" Color="{DynamicResource ColorPanel}"/>
        <SolidColorBrush x:Key="BorderLine" Color="{DynamicResource ColorBorder}"/>
        <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource ColorTextMuted}"/>
        <SolidColorBrush x:Key="Accent" Color="{DynamicResource ColorAccent}"/>
        <SolidColorBrush x:Key="Up" Color="{DynamicResource ColorUp}"/>
        <SolidColorBrush x:Key="Down" Color="{DynamicResource ColorDown}"/>

        <SolidColorBrush x:Key="GroupBg0" Color="{DynamicResource ColorPanel}"/>
        <SolidColorBrush x:Key="GroupBg1" Color="#252A36"/>
        <SolidColorBrush x:Key="GroupBg2" Color="#2D3342"/>
        <SolidColorBrush x:Key="GroupBg3" Color="#363C4A"/>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#363A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="TertiaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Recursive template for condition nodes (groups and leaves) -->
        <HierarchicalDataTemplate x:Key="ConditionNodeTemplate"
                                  DataType="{x:Type local:ConditionNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <Border CornerRadius="4" Padding="10" Margin="{Binding Margin}"
                    BorderBrush="{StaticResource BorderLine}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource GroupBg0}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Depth}" Value="1">
                                <Setter Property="Background" Value="{StaticResource GroupBg1}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Depth}" Value="2">
                                <Setter Property="Background" Value="{StaticResource GroupBg2}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Depth}" Value="3">
                                <Setter Property="Background" Value="{StaticResource GroupBg3}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- Group header -->
                    <StackPanel Visibility="{Binding GroupVisibility}" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox Width="280" Margin="0,0,8,0"
                                  ItemsSource="{Binding DataContext.ModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Mode}"/>
                        <Button Content="+ Add condition" Style="{StaticResource SecondaryButton}" Padding="8,4"
                                Tag="{Binding}" Click="AddCondition_Click" Margin="0,0,6,0"/>
                        <Button Content="+ Add group" Style="{StaticResource SecondaryButton}" Padding="8,4"
                                IsEnabled="{Binding CanAddGroup}" Tag="{Binding}" Click="AddGroup_Click" Margin="0,0,6,0"
                                ToolTip="Nested groups are limited to 3 levels deep"/>
                        <Button Content="🗑" Style="{StaticResource TertiaryButton}" Padding="8,4"
                                Visibility="{Binding RemoveVisibility}" Tag="{Binding}" Click="RemoveNode_Click"/>
                    </StackPanel>

                    <!-- Leaf condition fields -->
                    <StackPanel Visibility="{Binding LeafVisibility}" Orientation="Horizontal">
                        <TextBlock Text="When" Foreground="{StaticResource TextMuted}" Margin="0,5,8,0"/>
                        <ComboBox Width="170" Margin="0,0,6,0"
                                  ItemsSource="{Binding DataContext.TokenOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Left}"/>
                        <ComboBox Width="140" Margin="0,0,6,0"
                                  ItemsSource="{Binding DataContext.OpOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Op}"/>
                        <ComboBox Width="170" Margin="0,0,6,0"
                                  ItemsSource="{Binding DataContext.TokenOptionsWithNumber, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding Right}"/>
                        <TextBox Text="{Binding Number}" Width="55" Margin="0,0,6,0"
                                 ToolTip="Used only when the right side is a number"/>
                        <TextBlock Text="weight" Foreground="{StaticResource TextMuted}" Margin="0,5,6,0"/>
                        <TextBox Text="{Binding Weight}" Width="45" Margin="0,0,6,0"/>
                        <TextBlock Text="tol %" Foreground="{StaticResource TextMuted}" Margin="0,5,6,0"
                                   ToolTip="Percent distance for near support/resistance"/>
                        <TextBox Text="{Binding Tolerance}" Width="45" Margin="0,0,6,0"/>
                        <Button Content="🗑" Style="{StaticResource TertiaryButton}" Padding="8,4"
                                Tag="{Binding}" Click="RemoveNode_Click"/>
                    </StackPanel>

                    <!-- Nested children -->
                    <ItemsControl ItemsSource="{Binding Children}" 
                                  ItemTemplate="{DynamicResource ConditionNodeTemplate}"
                                  Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderLine}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="—" Width="46" Height="32" Style="{StaticResource WindowControlButton}" Click="Minimize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaximizeButton" Content="⛶" Width="46" Height="32" Style="{StaticResource WindowControlButton}" Click="Maximize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Width="46" Height="32" Style="{StaticResource CloseButton}" Click="Close_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                    <TextBlock x:Name="TitleText" Text="Strategy Builder" Foreground="{DynamicResource TextPrimary}"
                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Strategy Builder (Advanced)" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="Build your plan as plain sentences — no code needed."
                                   Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Strategy name" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NameBox" Text="My strategy" Width="220"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Symbol" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SymbolBox" Text="BTC/USDT" Width="120"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Timeframe" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TimeframeBox" Text="1h" Width="70"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Data source" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SourceCombo" Width="120">
                                    <ComboBoxItem Content="binance" IsSelected="True"/>
                                    <ComboBoxItem Content="hyperliquid"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{StaticResource BgPanel}" CornerRadius="6" Padding="16" Margin="0,0,0,14"
                                BorderBrush="{StaticResource BorderLine}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📊 Indicators (pick from the registry)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Each indicator gets a short id (like ema9) that your sentences below can refer to."
                                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="IndicatorsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <ComboBox Width="280" Margin="0,0,8,0"
                                                              ItemsSource="{Binding DataContext.GroupedRegistry, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValuePath="Type"
                                                              SelectedValue="{Binding Type}"
                                                              SelectionChanged="IndicatorType_Changed">
                                                        <ComboBox.GroupStyle>
                                                            <GroupStyle>
                                                                <GroupStyle.HeaderTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                                                   Foreground="{StaticResource Accent}" FontSize="11"/>
                                                                    </DataTemplate>
                                                                </GroupStyle.HeaderTemplate>
                                                            </GroupStyle>
                                                        </ComboBox.GroupStyle>
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Label}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock Text="period" Foreground="{StaticResource TextMuted}" Margin="0,5,6,0"/>
                                                    <TextBox Text="{Binding Period}" Width="55" Margin="0,0,8,0"/>
                                                    <Button Content="✕" Style="{StaticResource TertiaryButton}" Padding="8,4"
                                                            Tag="{Binding}" Click="RemoveIndicator_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="+ Add indicator" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Padding="12,5" Margin="0,4,0,0" Click="AddIndicator_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BgPanel}" CornerRadius="6" Padding="16" Margin="0,0,0,14"
                                BorderBrush="{StaticResource BorderLine}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🎯 Entry rules — when to BUY" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="min score" Foreground="{StaticResource TextMuted}" Margin="14,5,6,0"/>
                                    <TextBox x:Name="EntryMinScoreBox" Text="3" Width="50"/>
                                </StackPanel>
                                <ItemsControl x:Name="EntryList" ItemTemplate="{DynamicResource ConditionNodeTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BgPanel}" CornerRadius="6" Padding="16" Margin="0,0,0,14"
                                BorderBrush="{StaticResource BorderLine}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🚪 Exit rules — when to SELL / close" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="ExitList" ItemTemplate="{DynamicResource ConditionNodeTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource BgPanel}" CornerRadius="6" Padding="16" Margin="0,0,0,16"
                                BorderBrush="{StaticResource BorderLine}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="🛡 Risk plan (stop-loss, target, sizing)" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Stop-loss method" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="StopMethodCombo" Width="160"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Stop value (percent or ATR x)" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="StopValueBox" Text="2" Width="70"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Target method" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="TargetMethodCombo" Width="160"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Target value (ratio or percent)" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TargetValueBox" Text="2" Width="70"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Risk per trade (percent of balance)" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="RiskPercentBox" Text="1" Width="70"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save strategy" Style="{StaticResource PrimaryButton}" Padding="16,8" FontSize="13"
                                    Click="SaveStrategy_Click"/>
                            <Button x:Name="ChecklistButton" Content="🐾 Checklist: Default" Style="{StaticResource TertiaryButton}"
                                    Padding="12,6" Margin="10,0,0,0" Click="CustomizeChecklist_Click"/>
                            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMuted}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Quick test + live summary at bottom -->
                <Border Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderLine}" BorderThickness="0,1,0,0" Padding="20,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="TestButton" Content="🧪 Test this strategy" 
                                    Style="{StaticResource SecondaryButton}" Padding="14,6"
                                    Click="Test_Click"/>
                            <Button Content="📉 Risk of Ruin" Style="{StaticResource TertiaryButton}"
                                    Padding="14,6" Margin="8,0,0,0" Click="RiskOfRuin_Click"/>
                            <ComboBox x:Name="TestPeriodCombo" Width="140" Margin="10,0,0,0" VerticalAlignment="Center">
                                <ComboBoxItem Content="Last 30 days" Tag="30"/>
                                <ComboBoxItem Content="Last 90 days" Tag="90" IsSelected="True"/>
                                <ComboBoxItem Content="Last 6 months" Tag="180"/>
                                <ComboBoxItem Content="Last 1 year" Tag="365"/>
                            </ComboBox>
                        </StackPanel>

                        <Border x:Name="TestResultPanel" Background="{DynamicResource BackgroundBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,10" Visibility="Collapsed"
                                BorderBrush="{StaticResource BorderLine}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TestResultStatus" Text="—" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,6"/>
                                <Border x:Name="TestSampleWarningBanner" CornerRadius="3" Padding="8,5" Margin="0,0,0,6" Visibility="Collapsed">
                                    <TextBlock x:Name="TestSampleWarningText" FontSize="11" TextWrapping="Wrap"/>
                                </Border>

                                <UniformGrid Columns="4" Margin="0,0,0,6">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Win rate" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                        <TextBlock x:Name="TestWinRate" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Trades" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                        <TextBlock x:Name="TestTrades" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Avg R:R" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                        <TextBlock x:Name="TestRR" Text="—" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Max DD" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                        <TextBlock x:Name="TestDD" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Down}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                                <Button x:Name="SeeFullReportButton" Content="See full report →" 
                                        Style="{StaticResource TertiaryButton}" Padding="10,4"
                                        HorizontalAlignment="Left" Click="SeeFullReport_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="📖 Plain-English summary (updates live)" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DescriptionText" Text="—" Foreground="{StaticResource TextPrimary}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>