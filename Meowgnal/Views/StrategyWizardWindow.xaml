<Window x:Class="Meowgnal.Views.StrategyWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strategy Wizard" Height="560" Width="560"
        Background="#131722" WindowStartupLocation="CenterOwner"
        FontFamily="Trebuchet MS" FontSize="12">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#1E222D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2A2E39"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#D1D4DC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B2B5BE"/>
        <SolidColorBrush x:Key="TextMuted" Color="#787B86"/>
        <SolidColorBrush x:Key="Accent" Color="#2962FF"/>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Pill-shaped radio button -->
        <Style x:Key="PillRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Strategy Wizard" Foreground="{StaticResource TextPrimary}"
                       FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Answer 3 simple questions — the wizard builds a complete strategy for you."
                       Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Question 1 -->
        <Border Grid.Row="1" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="1) What is your trading style?" Foreground="{StaticResource TextPrimary}"
                           FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="StyleTrend" Content="Trend" GroupName="StyleGroup"
                                 Style="{StaticResource PillRadio}" IsChecked="True"/>
                    <RadioButton x:Name="StyleReversal" Content="Reversal" GroupName="StyleGroup"
                                 Style="{StaticResource PillRadio}"/>
                    <RadioButton x:Name="StyleBreakout" Content="Breakout" GroupName="StyleGroup"
                                 Style="{StaticResource PillRadio}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Question 2 -->
        <Border Grid.Row="2" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="2) How fast do you trade?" Foreground="{StaticResource TextPrimary}"
                           FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SpeedScalp" Content="Scalp" GroupName="SpeedGroup"
                                 Style="{StaticResource PillRadio}"/>
                    <RadioButton x:Name="SpeedSwing" Content="Swing" GroupName="SpeedGroup"
                                 Style="{StaticResource PillRadio}" IsChecked="True"/>
                    <RadioButton x:Name="SpeedLongTerm" Content="Long-term" GroupName="SpeedGroup"
                                 Style="{StaticResource PillRadio}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Question 3 -->
        <Border Grid.Row="3" Background="{StaticResource PanelBg}" CornerRadius="6" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="3) How careful are you with risk?" Foreground="{StaticResource TextPrimary}"
                           FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="CautionCareful" Content="Careful" GroupName="CautionGroup"
                                 Style="{StaticResource PillRadio}"/>
                    <RadioButton x:Name="CautionBalanced" Content="Balanced" GroupName="CautionGroup"
                                 Style="{StaticResource PillRadio}" IsChecked="True"/>
                    <RadioButton x:Name="CautionAggressive" Content="Aggressive" GroupName="CautionGroup"
                                 Style="{StaticResource PillRadio}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Content="Save &amp; use" Padding="16,8" Style="{StaticResource PrimaryButton}"
                    Click="SaveAndUse_Click"/>
            <Button Content="Open in builder" Padding="16,8" Margin="10,0,0,0"
                    Style="{StaticResource SecondaryButton}" Click="OpenInBuilder_Click"/>
        </StackPanel>
    </Grid>
</Window>