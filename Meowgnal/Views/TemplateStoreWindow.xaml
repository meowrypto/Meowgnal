<Window x:Class="Meowgnal.Views.TemplateStoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strategy Templates" Height="680" Width="900"
        WindowStyle="None" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Trebuchet MS" FontSize="12">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource ColorBackground}"/>
        <SolidColorBrush x:Key="PanelBg" Color="{DynamicResource ColorPanel}"/>
        <SolidColorBrush x:Key="BorderColor" Color="{DynamicResource ColorBorder}"/>
        <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource ColorTextMuted}"/>
        <SolidColorBrush x:Key="Accent" Color="{DynamicResource ColorAccent}"/>
        <SolidColorBrush x:Key="Up" Color="{DynamicResource ColorUp}"/>
        <SolidColorBrush x:Key="Down" Color="{DynamicResource ColorDown}"/>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#363A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TertiaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="—" Width="46" Height="32" Style="{StaticResource WindowControlButton}" Click="Minimize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaximizeButton" Content="⛶" Width="46" Height="32" Style="{StaticResource WindowControlButton}" Click="Maximize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Width="46" Height="32" Style="{StaticResource CloseButton}" Click="Close_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                    <TextBlock x:Name="TitleText" Text="Strategy Templates" Foreground="{StaticResource TextPrimary}"
                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </DockPanel>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="Strategy Templates" Foreground="{StaticResource TextPrimary}"
                               FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="SubtitleText" Text="Pick a template or build from scratch"
                               Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,4,0,0"/>

                    <!-- Wizard banner -->
                    <Border Background="{StaticResource PanelBg}" CornerRadius="4" Padding="12,8" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Not sure where to start? Answer 3 questions and let the wizard build one for you."
                                       Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                            <Button Content="✨ Help me choose" Padding="12,5" Margin="16,0,0,0"
                                    Style="{StaticResource SecondaryButton}" Click="OpenWizard_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Current symbol indicator -->
                <Border Grid.Row="1" Background="{StaticResource PanelBg}" CornerRadius="4"
                        Padding="12,8" Margin="0,10,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Active chart:" Foreground="{StaticResource TextMuted}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ActiveSymbolText" Text="—" Foreground="{StaticResource Accent}"
                                   FontSize="13" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text=" · backtests run on this symbol" Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="10,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable grid of template cards -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TemplatesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBg}" CornerRadius="6"
                                        Padding="16" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Template.Name}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Template.Description}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>

                                        <!-- Badges row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Background="{StaticResource BorderColor}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Template.Style}" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                            </Border>
                                            <Border Background="{StaticResource BorderColor}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Template.DefaultTimeframe}" Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                            </Border>
                                            <Border Background="{StaticResource BorderColor}" CornerRadius="3" Padding="6,2">
                                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="10">
                                                    <Run Text="Risk: "/><Run Text="{Binding Template.RiskLevel, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <!-- Backtest stats -->
                                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Backtest (500 candles)" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock Text="Win rate" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                        <TextBlock Text="{Binding WinRate}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock Text="Trades" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                        <TextBlock Text="{Binding TradeCount}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Return" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                                        <TextBlock Text="{Binding ReturnPct}" Foreground="{Binding ReturnColor}" FontSize="13" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Action buttons -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Use" Width="80" Padding="8,6"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Tag="{Binding}" Click="UseTemplate_Click"/>
                                            <Button Content="Customize" Width="90" Padding="8,6" Margin="8,0,0,0"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Tag="{Binding}" Click="CustomizeTemplate_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Bottom button -->
                <Border Grid.Row="3" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Advanced builder (from scratch)" Padding="20,8" FontSize="13"
                                Style="{StaticResource TertiaryButton}"
                                Click="BuildFromScratch_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>