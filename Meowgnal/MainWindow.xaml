<Window x:Class="Meowgnal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Meowgnal.Views"
        Title="Meowgnal" Height="560" Width="900"
        Background="#0F1117">

    <Window.Resources>
        <views:SignalTypeToBrushConverter x:Key="TypeToBrushConverter"/>
        <SolidColorBrush x:Key="PanelBg" Color="#161A23"/>
        <SolidColorBrush x:Key="BorderColor" Color="#262B38"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8A8F9C"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#26A69A"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF5350"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="230"/>
        </Grid.ColumnDefinitions>

        <!-- Left icon rail -->
        <Border Grid.Column="0" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Top" Margin="0,16,0,0">
                <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="White"/>
                <TextBlock Text="🧩" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Text="📈" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Text="🔔" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SymbolText" Text="BTC/USDT" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PriceText" Text="—" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="RefreshButton" Content="Refresh signals" Padding="10,4" Margin="16,0,0,0" Click="RefreshButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Chart placeholder -->
            <Border Grid.Row="1" Background="#0B0D12" Margin="0">
                <TextBlock Text="chart area (coming soon)" Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
            </Border>

            <!-- Stat cards -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="14">
                <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Active strategies" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock Text="1" Foreground="White" FontSize="18" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Win rate (backtest)" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock x:Name="WinRateText" Text="—" Foreground="White" FontSize="18" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="Signals found" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock x:Name="SignalCountText" Text="—" Foreground="White" FontSize="18" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Right signal panel -->
        <Border Grid.Column="2" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0">
            <DockPanel>
                <TextBlock Text="Active signals" Foreground="{StaticResource TextMuted}" Margin="14,12" DockPanel.Dock="Top"/>
                <ItemsControl x:Name="SignalsList" Margin="0,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Symbol}" Foreground="White" FontSize="13" FontWeight="Medium"/>
                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,1"
                                                Background="{Binding Type, Converter={StaticResource TypeToBrushConverter}}">
                                            <TextBlock Text="{Binding Type}" FontSize="10" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>