                                    BorderThickness="1" CornerRadius="4" Padding="4" Margin="4,0,0,0">
                                <StackPanel>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="rectangle" Click="ToolButton_Click">
                                        <TextBlock Text="Rectangle (2 clicks)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="rotatedrectangle" Click="ToolButton_Click">
                                        <TextBlock Text="Rotated Rectangle" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="circle" Click="ToolButton_Click">
                                        <TextBlock Text="Circle (center + radius)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="ellipse" Click="ToolButton_Click">
                                        <TextBlock Text="Ellipse" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="triangle" Click="ToolButton_Click">
                                        <TextBlock Text="Triangle (3 clicks)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="polyline" Click="ToolButton_Click">
                                        <TextBlock Text="Polyline (multi-click, right-click to finish)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="arc" Click="ToolButton_Click">
                                        <TextBlock Text="Arc (3 clicks)" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
