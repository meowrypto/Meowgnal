                        <DockPanel x:Name="WatchlistPane">
                            <Border DockPanel.Dock="Top" Padding="6,5"
                                    BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="WatchlistNameButton" Style="{StaticResource TvButtonLeft}"
                                            Click="WatchlistNameButton_Click" ToolTip="Switch watchlist">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="WatchlistNameText" Text="Main" Foreground="{DynamicResource TextPrimary}"
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center" Margin="6,1,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="NewWatchlistButton" Grid.Column="1" Content="＋ List" Style="{StaticResource TvButton}"
                                            ToolTip="Create a new watchlist" Click="NewWatchlistButton_Click"/>
                                    <Button x:Name="AddSymbolButton" Grid.Column="2" Content="＋ Symbol" Style="{StaticResource TvButton}"
                                            ToolTip="Add a symbol to this watchlist" Click="AddSymbolButton_Click"/>

                                    <Popup x:Name="WatchlistSwitchPopup" StaysOpen="False" AllowsTransparency="True"
                                           Placement="Bottom" PlacementTarget="{Binding ElementName=WatchlistNameButton}">
                                        <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                                BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,4,0,0">
                                            <StackPanel x:Name="SwitchListPanel"/>
                                        </Border>
                                    </Popup>

                                    <Popup x:Name="NewWatchlistPopup" StaysOpen="False" AllowsTransparency="True"
                                           Placement="Bottom" PlacementTarget="{Binding ElementName=NewWatchlistButton}">
                                        <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Watchlist name" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                <TextBox x:Name="NewWatchlistNameBox" Width="160" Margin="0,4,0,8"
                                                         Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimary}"
                                                         BorderBrush="{DynamicResource BorderLine}" CaretBrush="{DynamicResource TextPrimary}"/>
                                                <Button Content="Create" Style="{StaticResource TvButton}" Click="NewWatchlistConfirm_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>

                                    <Popup x:Name="AddSymbolPopup" StaysOpen="False" AllowsTransparency="True"
                                           Placement="Bottom" PlacementTarget="{Binding ElementName=AddSymbolButton}">
                                        <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Symbol (e.g. BTC/USDT)" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                <TextBox x:Name="AddSymbolBox" Text="BTC/USDT" Width="200" Margin="0,4,0,8"
                                                         TextChanged="AddSymbolBox_TextChanged"
                                                         Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimary}"
                                                         BorderBrush="{DynamicResource BorderLine}" CaretBrush="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="Pick the price source:" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                                                <RadioButton x:Name="SourceBinanceRadio" Content="Binance — …" GroupName="AddSrc"
                                                             Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                                <RadioButton x:Name="SourceHyperRadio" Content="Hyperliquid — …" GroupName="AddSrc"
                                                             Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                                <Button Content="Add to watchlist" Style="{StaticResource TvButton}" Click="AddSymbolConfirm_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="WatchlistRowsPanel" Margin="10,8,10,8"/>
                            </ScrollViewer>
                        </DockPanel>

                        <!-- Signals pane -->
                        <DockPanel x:Name="SignalsPane" Visibility="Collapsed">
                            <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}"
                                    BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,0,1" Padding="12,8">
                                <TextBlock Text="Active signals" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="Bold"/>
                            </Border>
                            <ItemsControl x:Name="SignalsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,0,1" Padding="12,8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Symbol}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold"/>
                                                    <Border Grid.Column="1" CornerRadius="3" Padding="6,1" Margin="0,0,6,0"
                                                            Background="{Binding Type, Converter={StaticResource TypeToBrushConverter}}">
                                                        <TextBlock Text="{Binding Type}" FontSize="10" Foreground="White"/>
                                                    </Border>
                                                    <Border Grid.Column="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right"
                                                            Background="{Binding QualityLabel, Converter={StaticResource QualityToBrushConverter}}">
                                                        <TextBlock Text="{Binding QualityLabel}" FontSize="10" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <!-- Paper trading pane -->
                        <DockPanel x:Name="PaperPane" Visibility="Collapsed">
                            <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}"
                                    BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,0,1" Padding="12,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="PAPER BALANCE" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                            <TextBlock x:Name="PaperBalanceText" Text="—" Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="UNREALIZED PNL" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                            <TextBlock x:Name="PaperUnrealizedText" Text="—" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="PaperEquityText" Text="Equity: —" Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" Margin="0,6,0,0"/>
                                    <CheckBox x:Name="AutoTradeCheck" Content="Auto-trade signals"
                                              Foreground="{DynamicResource TextSecondary}"
                                              Margin="0,10,0,0" Click="AutoTradeCheck_Click"/>
                                    <Button x:Name="OpenPositionButton" Content="＋ Open position" Style="{StaticResource TvButton}"
                                            HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="OpenPositionButton_Click"/>

                                    <Popup x:Name="OpenPositionPopup" StaysOpen="False" AllowsTransparency="True"
                                           Placement="Left" PlacementTarget="{Binding ElementName=OpenPositionButton}">
                                        <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                                BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,4,0" Width="240">
                                            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <TextBlock Text="Symbol" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                    <TextBox x:Name="PopSymbolBox" Text="BTC/USDT" Margin="0,4,0,8"
                                                             Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimary}"
                                                             BorderBrush="{DynamicResource BorderLine}" CaretBrush="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="Side" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                                        <RadioButton x:Name="PopSideLong" Content="Long" GroupName="PopSide"
                                                                     Foreground="{DynamicResource Up}" IsChecked="True" Margin="0,0,14,0"/>
                                                        <RadioButton x:Name="PopSideShort" Content="Short" GroupName="PopSide"
                                                                     Foreground="{DynamicResource Down}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Leverage (x)" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                    <TextBox x:Name="PopLeverageBox" Text="10" Margin="0,4,0,8"
                                                             Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimary}"
                                                             BorderBrush="{DynamicResource BorderLine}" CaretBrush="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="Margin (USDT)" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                    <TextBox x:Name="PopMarginBox" Text="1000" Margin="0,4,0,8"
                                                             Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimary}"
                                                             BorderBrush="{DynamicResource BorderLine}" CaretBrush="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="Stop-loss %" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                    <TextBox x:Name="PopSLBox" Text="2" Margin="0,4,0,8"
                                                             Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimary}"
                                                             BorderBrush="{DynamicResource BorderLine}" CaretBrush="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="Take-profit %" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                                    <TextBox x:Name="PopTPBox" Text="4" Margin="0,4,0,8"
                                                             Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimary}"
                                                             BorderBrush="{DynamicResource BorderLine}" CaretBrush="{DynamicResource TextPrimary}"/>
                                                    <CheckBox x:Name="PopTrailingCheck" Content="Trailing stop" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="Distance %" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                                            <TextBox x:Name="PopTrailingDistBox" Text="2" Width="70" Margin="0,2,0,0"
                                                                     Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimary}"
                                                                     BorderBrush="{DynamicResource BorderLine}" CaretBrush="{DynamicResource TextPrimary}"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="Activate after %" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                                            <TextBox x:Name="PopTrailingActBox" Text="2" Width="70" Margin="0,2,0,0"
                                                                     Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimary}"
                                                                     BorderBrush="{DynamicResource BorderLine}" CaretBrush="{DynamicResource TextPrimary}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Content="Open position" Style="{StaticResource TvButton}" Click="OpenPositionConfirm_Click"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10,8,10,8">
                                    <TextBlock Text="OPEN POSITIONS" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,0,0,6"/>
                                    <StackPanel x:Name="PaperPositionsPanel"/>
                                    <TextBlock Text="HISTORY (last 10)" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,16,0,6"/>
                                    <StackPanel x:Name="PaperHistoryPanel"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>