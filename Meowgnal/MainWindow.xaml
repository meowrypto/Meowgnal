                        </Button>
                        <Popup x:Name="BrushPopup" StaysOpen="False" AllowsTransparency="True"
                               Placement="Right" PlacementTarget="{Binding ElementName=BrushGroupButton}">
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                    BorderThickness="1" CornerRadius="4" Padding="4" Margin="4,0,0,0">
                                <StackPanel>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="arrow" Click="ToolButton_Click">
                                        <TextBlock Text="Arrow (2 clicks)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="arrowmarkup" Click="ToolButton_Click">
                                        <TextBlock Text="Arrow Mark Up" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="arrowmarkdown" Click="ToolButton_Click">
                                        <TextBlock Text="Arrow Mark Down" VerticalAlignment="Center"/>
                                    </Button>
                                    <Border Height="1" Background="{DynamicResource BorderLine}" Margin="4,4"/>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="brush" Click="ToolButton_Click">
                                        <TextBlock Text="Brush (multi-click)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="highlighter" Click="ToolButton_Click">
                                        <TextBlock Text="Highlighter" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Annotations group -->
                        <Button x:Name="AnnotGroupButton" Style="{StaticResource RailButton}"
                                Click="AnnotGroup_Click" ToolTip="Text and annotations">
                            <ContentControl Content="{StaticResource Icon_annot}" Width="18" Height="18"/>
                        </Button>
                        <Popup x:Name="AnnotPopup" StaysOpen="False" AllowsTransparency="True"
                               Placement="Right" PlacementTarget="{Binding ElementName=AnnotGroupButton}">
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                    BorderThickness="1" CornerRadius="4" Padding="4" Margin="4,0,0,0">
                                <StackPanel>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="text" Click="ToolButton_Click">
                                        <TextBlock Text="Text (type on chart)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="note" Click="ToolButton_Click">
                                        <TextBlock Text="Note (boxed text)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="pricelabel" Click="ToolButton_Click">
                                        <TextBlock Text="Price Label" VerticalAlignment="Center"/>
                                    </Button>
                                    <Border Height="1" Background="{DynamicResource BorderLine}" Margin="4,4"/>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="pin" Click="ToolButton_Click">
                                        <TextBlock Text="Pin" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="flag" Click="ToolButton_Click">
                                        <TextBlock Text="Flag" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="sticker" Click="ToolButton_Click">
                                        <TextBlock Text="Sticker / Emoji" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Rectangle Width="24" Height="1" Fill="{DynamicResource BorderLine}" Margin="0,6,0,6"/>

                        <Button x:Name="ToolAutoSRButton" Style="{StaticResource RailButton}" Tag="auto_sr"
                                Click="ToolButton_Click" ToolTip="Auto Support/Resistance — detect important levels">
                            <ContentControl Content="{StaticResource Icon_autosr}" Width="18" Height="18"/>
                        </Button>
                        <Button x:Name="ToggleDrawingsButton" Style="{StaticResource RailButton}"
                                Click="ToggleDrawingsVisibility_Click" ToolTip="Show / hide all drawings">
                            <TextBlock Text="👁" FontSize="15"/>
                        </Button>
                        <Button x:Name="ObjectsRailButton" Style="{StaticResource RailButton}"
                                Click="ObjectsButton_Click" ToolTip="Objects list — manage drawings">
                            <TextBlock Text="📋" FontSize="15"/>
                        </Button>
                        <Button x:Name="ToolClearButton" Style="{StaticResource RailButton}" Tag="clear"
                                Click="TrashButton_Click" ToolTip="Delete drawings">
                            <ContentControl Content="{StaticResource Icon_trash}" Width="18" Height="18"/>
                        </Button>
                        <Popup x:Name="TrashPopup" StaysOpen="False" AllowsTransparency="True"
                               Placement="Right" PlacementTarget="{Binding ElementName=ToolClearButton}">
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                    BorderThickness="1" CornerRadius="4" Padding="4" Margin="4,0,0,0">
                                <StackPanel>
                                    <Button Style="{StaticResource TvButtonLeft}" Click="ClearAllDrawings_Click">
                                        <TextBlock Text="🗑 Delete ALL drawings" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Click="ChooseDeleteDrawings_Click">
                                        <TextBlock Text="✂ Choose drawings to delete" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>

                <!-- Main content -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Symbol tabs -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,0,1" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel x:Name="TabsPanel" Orientation="Horizontal"/>
                            <Button x:Name="AddTabButton" Content="＋" Style="{StaticResource TvButton}"
                                    ToolTip="Open a new chart tab" Click="AddTabButton_Click"/>
                            <Popup x:Name="NewTabPopup" StaysOpen="False" AllowsTransparency="True"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=AddTabButton}">
                                <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                        BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Symbol (e.g. ETH/USDT)" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                        <TextBox x:Name="NewTabSymbolBox" Text="ETH/USDT" Width="170" Margin="0,4,0,8"
                                                 Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimary}"
                                                 BorderBrush="{DynamicResource BorderLine}" CaretBrush="{DynamicResource TextPrimary}"/>
                                        <Button Content="Open chart" Style="{StaticResource TvButton}" Click="NewTabOpen_Click"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>

                    <!-- Top bar -->
                    <Border Grid.Row="1" Background="{DynamicResource BgPanel}"
                            BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SymbolText" Text="BTC/USDT" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PriceText" Text="—" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="RefreshButton" Content="⟳ Refresh" Style="{StaticResource TvButton}" Click="RefreshButton_Click"/>
                                <Button x:Name="OpenBuilderButton" Content="＋ New strategy" Style="{StaticResource TvButton}" Click="OpenBuilderButton_Click"/>
                                <Button x:Name="OpenBacktestButton" Content="Backtest" Style="{StaticResource TvButton}" Click="OpenBacktestButton_Click"/>
                                <Button x:Name="OpenJournalButton" Content="📓 Journal" Style="{StaticResource TvButton}" Click="OpenJournalButton_Click"/>
                                <Button x:Name="OpenSettingsButton" Content="⚙ Settings" Style="{StaticResource TvButton}" Click="OpenSettingsButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Chart toolbar -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,0,1" Padding="8,4">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel x:Name="TimeframePanel" Orientation="Horizontal"/>
                                <Button x:Name="TimeframeMenuButton" Content="▾" Style="{StaticResource TvButton}"
                                        ToolTip="All timeframes" Click="TimeframeMenuButton_Click"/>
                                <Popup x:Name="TimeframePopup" StaysOpen="False" AllowsTransparency="True"
                                       Placement="Bottom" PlacementTarget="{Binding ElementName=TimeframeMenuButton}">
                                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                            BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,4,0,0">
                                        <ScrollViewer x:Name="TimeframeMenuScroll" VerticalScrollBarVisibility="Auto" MaxHeight="640">
                                            <StackPanel x:Name="TimeframeMenuPanel"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                                <Rectangle Width="1" Height="18" Fill="{DynamicResource BorderLine}" Margin="8,0"/>
                                <Button x:Name="ChartTypeButton" Style="{StaticResource TvButton}" Click="ChartTypeButton_Click" ToolTip="Chart type">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl x:Name="ChartTypeIcon" Width="18" Height="14" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="ChartTypeLabel" Text="Candles" VerticalAlignment="Center"/>
                                        <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="ChartTypePopup" StaysOpen="False" AllowsTransparency="True"
                                       Placement="Bottom" PlacementTarget="{Binding ElementName=ChartTypeButton}">
                                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                            BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,4,0,0">
                                        <StackPanel>
                                            <Button Style="{StaticResource TvButtonLeft}" Tag="candles" Click="ChartTypeItem_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Content="{StaticResource Icon_candles}" Width="18" Height="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Candles" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource TvButtonLeft}" Tag="bars" Click="ChartTypeItem_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Content="{StaticResource Icon_bars}" Width="18" Height="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Bars (OHLC)" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource TvButtonLeft}" Tag="line" Click="ChartTypeItem_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Content="{StaticResource Icon_line}" Width="18" Height="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Line" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource TvButtonLeft}" Tag="area" Click="ChartTypeItem_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Content="{StaticResource Icon_area}" Width="18" Height="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Area" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource TvButtonLeft}" Tag="heikinashi" Click="ChartTypeItem_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Content="{StaticResource Icon_heikinashi}" Width="18" Height="14" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Heikin Ashi" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <Popup x:Name="ObjectsPopup" StaysOpen="False" AllowsTransparency="True"
                               Placement="Right" PlacementTarget="{Binding ElementName=ObjectsRailButton}">
                                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                    BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0" Width="360">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="📋 Objects — " Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ObjectsSymbolText" Text="" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Height="1" Background="{DynamicResource BorderLine}" Margin="0,0,0,8"/>
                                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="ObjectsListPanel"/>
                                            </ScrollViewer>
                                            <Border Height="1" Background="{DynamicResource BorderLine}" Margin="0,8,0,8"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="📤 Export template" Style="{StaticResource TvButton}" Click="ExportTemplate_Click" Margin="0,0,6,0"/>
                                                <Button Content="📥 Import template" Style="{StaticResource TvButton}" Click="ImportTemplate_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="ScreenshotButton" Content="📷" ToolTip="Save chart screenshot" Style="{StaticResource TvButton}" Click="ScreenshotButton_Click"/>
                                <Button x:Name="FullscreenButton" Content="⛶" ToolTip="Fullscreen (Esc to exit)" Style="{StaticResource TvButton}" Click="FullscreenButton_Click"/>
                                
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Chart + OHLC legend -->
                    <Grid Grid.Row="3" Background="{DynamicResource BackgroundBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,6,0,0">
                            <TextBlock Text="O" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OhlcOpenText" Text="—" FontSize="11" Margin="3,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="H" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OhlcHighText" Text="—" FontSize="11" Margin="3,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="L" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OhlcLowText" Text="—" FontSize="11" Margin="3,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="C" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OhlcCloseText" Text="—" FontSize="11" Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <wv2:WebView2 Grid.Row="1" x:Name="ChartWebView"/>
                    </Grid>

                    <!-- Stat cards -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="10,8">
                        <Border Background="{DynamicResource BgPanel}" CornerRadius="4" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Active strategies" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="ActiveStrategiesText" Text="0" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BgPanel}" CornerRadius="4" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Win rate (backtest)" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="WinRateText" Text="—" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BgPanel}" CornerRadius="4" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="Signals found" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                <TextBlock x:Name="SignalCountText" Text="—" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Bottom status bar -->
                    <Border Grid.Row="5" Background="{DynamicResource BgPanel}"
                            BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,1,0,0" Padding="10,4">
                        <Grid>
                            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}">
                                <Hyperlink NavigateUri="https://www.tradingview.com"
                                           RequestNavigate="TradingViewLink_RequestNavigate"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextDecorations="None">Chart powered by TradingView Lightweight Charts</Hyperlink>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="PaperStatusText" Text="" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,12,0"/>
                                <Button x:Name="ClockButton" Style="{StaticResource TvButton}" Click="ClockButton_Click"
                                        ToolTip="Clock time zone — click to change">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ClockText" Text="--:--:--" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ClockZoneText" Text="UTC" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="▾" FontSize="8" Foreground="{DynamicResource TextMuted}"
                                                   Margin="4,1,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="ClockPopup" StaysOpen="False" AllowsTransparency="True"
                                       Placement="Top" PlacementTarget="{Binding ElementName=ClockButton}">
                                    <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                            BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,0,4" Width="270">
                                        <StackPanel>
                                            <Button Style="{StaticResource TvButtonLeft}" Tag="utc" Click="ClockMode_Click">
                                                <TextBlock Text="UTC — exchange standard" FontSize="11"/>
                                            </Button>
                                            <Button Style="{StaticResource TvButtonLeft}" Tag="system" Click="ClockMode_Click">
                                                <TextBlock Text="System local time" FontSize="11"/>
                                            </Button>
                                            <Border Height="1" Background="{DynamicResource BorderLine}" Margin="4,4"/>
                                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="TimeZoneListPanel"/>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right panel -->
                <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderLine}" BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}"
                                BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="TabWatchlistButton" Content="Watchlist" Style="{StaticResource TvButton}"
                                        Background="{DynamicResource Accent}" Foreground="White" Click="RightTabWatchlist_Click"/>
                                <Button x:Name="TabSignalsButton" Grid.Column="1" Content="Signals" Style="{StaticResource TvButton}"
                                        Click="RightTabSignals_Click"/>
                                <Button x:Name="TabPaperButton" Grid.Column="2" Content="Paper" Style="{StaticResource TvButton}"
                                        Click="RightTabPaper_Click"/>
                            </Grid>
                        </Border>

