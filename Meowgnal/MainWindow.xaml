<Window x:Class="Meowgnal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Meowgnal.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Meowgnal" Height="600" Width="980"
        Background="#131722"
        FontFamily="Trebuchet MS"
        FontSize="12"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <views:SignalTypeToBrushConverter x:Key="TypeToBrushConverter"/>
        <SolidColorBrush x:Key="BgPanel" Color="#1E222D"/>
        <SolidColorBrush x:Key="BorderLine" Color="#2A2E39"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#D1D4DC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B2B5BE"/>
        <SolidColorBrush x:Key="TextMuted" Color="#787B86"/>
        <SolidColorBrush x:Key="Accent" Color="#2962FF"/>
        <SolidColorBrush x:Key="Up" Color="#089981"/>
        <SolidColorBrush x:Key="Down" Color="#F23645"/>

        <!-- Flat TradingView-style button with hover -->
        <Style x:Key="TvButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2E39"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <!-- Left tool rail (TV style) -->
        <Border Grid.Column="0" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Top" Margin="0,10,0,0">
                <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="🧩" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Text="📈" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,0,1" Padding="10,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🐱" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Meowgnal" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Rectangle Width="1" Height="18" Fill="{StaticResource BorderLine}" Margin="0,0,14,0"/>
                        <TextBlock x:Name="SymbolText" Text="BTC/USDT" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PriceText" Text="—" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="RefreshButton" Content="⟳ Refresh" Style="{StaticResource TvButton}" Click="RefreshButton_Click"/>
                        <Button x:Name="OpenBuilderButton" Content="＋ New strategy" Style="{StaticResource TvButton}" Click="OpenBuilderButton_Click"/>
                        <Button x:Name="OpenBacktestButton" Content="Backtest" Style="{StaticResource TvButton}" Click="OpenBacktestButton_Click"/>
                        <Button x:Name="OpenSettingsButton" Content="⚙ Settings" Style="{StaticResource TvButton}" Click="OpenSettingsButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chart toolbar -->
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,0,1" Padding="8,4">
                <Grid>
                    <StackPanel x:Name="TimeframePanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="15m" Tag="15m" Style="{StaticResource TvButton}" Click="TimeframeButton_Click"/>
                        <Button x:Name="DefaultTfButton" Content="1h" Tag="1h" Style="{StaticResource TvButton}" Click="TimeframeButton_Click" Background="{StaticResource Accent}" Foreground="White"/>
                        <Button Content="4h" Tag="4h" Style="{StaticResource TvButton}" Click="TimeframeButton_Click"/>
                        <Button Content="1D" Tag="1d" Style="{StaticResource TvButton}" Click="TimeframeButton_Click"/>
                        <Button Content="1W" Tag="1w" Style="{StaticResource TvButton}" Click="TimeframeButton_Click"/>
                        <Rectangle Width="1" Height="18" Fill="{StaticResource BorderLine}" Margin="8,0"/>
                        <ComboBox x:Name="ChartTypeCombo" Width="120"
                                  Background="{StaticResource BgPanel}" Foreground="{StaticResource TextPrimary}"
                                  SelectionChanged="ChartTypeCombo_SelectionChanged">
                            <ComboBoxItem Content="Candles" Tag="candles"/>
                            <ComboBoxItem Content="Line" Tag="line"/>
                            <ComboBoxItem Content="Area" Tag="area"/>
                            <ComboBoxItem Content="Heikin Ashi" Tag="heikinashi"/>
                            <ComboBoxItem Content="Bars (OHLC)" Tag="bars"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="ScreenshotButton" Content="📷" ToolTip="Save chart screenshot" Style="{StaticResource TvButton}" Click="ScreenshotButton_Click"/>
                        <Button x:Name="FullscreenButton" Content="⛶" ToolTip="Fullscreen (Esc to exit)" Style="{StaticResource TvButton}" Click="FullscreenButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chart + OHLC legend -->
            <Grid Grid.Row="2" Background="#131722">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,6,0,0">
                    <TextBlock Text="O" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OhlcOpenText" Text="—" FontSize="11" Margin="3,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="H" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OhlcHighText" Text="—" FontSize="11" Margin="3,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="L" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OhlcLowText" Text="—" FontSize="11" Margin="3,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="C" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OhlcCloseText" Text="—" FontSize="11" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <wv2:WebView2 Grid.Row="1" x:Name="ChartWebView"/>
            </Grid>

            <!-- Stat cards -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10,8">
                <Border Background="{StaticResource BgPanel}" CornerRadius="4" Padding="12,8" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Active strategies" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock x:Name="ActiveStrategiesText" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BgPanel}" CornerRadius="4" Padding="12,8" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Win rate (backtest)" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock x:Name="WinRateText" Text="—" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource BgPanel}" CornerRadius="4" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="Signals found" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock x:Name="SignalCountText" Text="—" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Bottom status bar: license link (left) + live UTC clock (right) -->
            <Border Grid.Row="4" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderLine}" BorderThickness="0,1,0,0" Padding="10,4">
                <Grid>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource TextMuted}">
                        <Hyperlink NavigateUri="https://www.tradingview.com"
                                   RequestNavigate="TradingViewLink_RequestNavigate"
                                   Foreground="{StaticResource TextMuted}"
                                   TextDecorations="None">Chart powered by TradingView Lightweight Charts</Hyperlink>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="UtcClockText" Text="--:--:--" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text=" UTC" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Right signal panel (TV watchlist look) -->
        <Border Grid.Column="2" Background="#131722"
                BorderBrush="{StaticResource BorderLine}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,0,1" Padding="12,8">
                    <TextBlock Text="Active signals" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Bold"/>
                </Border>
                <ItemsControl x:Name="SignalsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,0,1" Padding="12,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Symbol}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold"/>
                                        <Border Grid.Column="1" CornerRadius="3" Padding="6,1"
                                                Background="{Binding Type, Converter={StaticResource TypeToBrushConverter}}">
                                            <TextBlock Text="{Binding Type}" FontSize="10" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>