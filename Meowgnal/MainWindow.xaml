<Window x:Class="Meowgnal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Meowgnal.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Meowgnal" Height="560" Width="900"
        Background="#0F1117"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <views:SignalTypeToBrushConverter x:Key="TypeToBrushConverter"/>
        <SolidColorBrush x:Key="PanelBg" Color="#161A23"/>
        <SolidColorBrush x:Key="BorderColor" Color="#262B38"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8A8F9C"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#26A69A"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF5350"/>
        <SolidColorBrush x:Key="AccentBg" Color="#1E2A38"/>
        <SolidColorBrush x:Key="AccentText" Color="#4FC3F7"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="230"/>
        </Grid.ColumnDefinitions>

        <!-- Left icon rail -->
        <Border Grid.Column="0" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Top" Margin="0,16,0,0">
                <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="White"/>
                <TextBlock Text="🧩" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Text="📈" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="{StaticResource TextMuted}"/>
                <TextBlock Text="🔔" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SymbolText" Text="BTC/USDT" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PriceText" Text="—" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="RefreshButton" Content="Refresh signals" Padding="10,4" Margin="16,0,0,0" Click="RefreshButton_Click"/>
                    <Button x:Name="OpenBuilderButton" Content="New strategy" Padding="10,4" Margin="8,0,0,0" Click="OpenBuilderButton_Click"/>
                    <Button x:Name="OpenBacktestButton" Content="Backtest" Padding="10,4" Margin="8,0,0,0" Click="OpenBacktestButton_Click"/>
                    <Button x:Name="OpenSettingsButton" Content="Settings" Padding="10,4" Margin="8,0,0,0" Click="OpenSettingsButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Chart toolbar -->
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,6">
                <Grid>
                    <StackPanel x:Name="TimeframePanel" Orientation="Horizontal">
                        <Button Content="15m" Tag="15m" Padding="8,3" Margin="0,0,4,0" Click="TimeframeButton_Click"/>
                        <Button x:Name="DefaultTfButton" Content="1h" Tag="1h" Padding="8,3" Margin="0,0,4,0" Click="TimeframeButton_Click" Background="{StaticResource AccentBg}" Foreground="{StaticResource AccentText}"/>
                        <Button Content="4h" Tag="4h" Padding="8,3" Margin="0,0,4,0" Click="TimeframeButton_Click"/>
                        <Button Content="1D" Tag="1d" Padding="8,3" Margin="0,0,4,0" Click="TimeframeButton_Click"/>
                        <Button Content="1W" Tag="1w" Padding="8,3" Margin="0,0,4,0" Click="TimeframeButton_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ComboBox x:Name="ChartTypeCombo" Width="120" Margin="0,0,8,0" SelectionChanged="ChartTypeCombo_SelectionChanged">
                            <ComboBoxItem Content="Candles" Tag="candles"/>
                            <ComboBoxItem Content="Line" Tag="line"/>
                            <ComboBoxItem Content="Area" Tag="area"/>
                            <ComboBoxItem Content="Heikin Ashi" Tag="heikinashi"/>
                            <ComboBoxItem Content="Bars (OHLC)" Tag="bars"/>
                        </ComboBox>
                        <Button x:Name="ScreenshotButton" Content="📷" ToolTip="Save chart screenshot" Padding="8,3" Margin="0,0,6,0" Click="ScreenshotButton_Click"/>
                        <Button x:Name="FullscreenButton" Content="⛶" ToolTip="Fullscreen (Esc to exit)" Padding="8,3" Click="FullscreenButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TradingView Lightweight Charts (inside WebView2) + OHLC header -->
            <Grid Grid.Row="2" Background="#0B0D12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,6,0,0">
                    <TextBlock Text="O" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OhlcOpenText" Text="—" FontSize="11" Margin="3,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="H" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OhlcHighText" Text="—" FontSize="11" Margin="3,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="L" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OhlcLowText" Text="—" FontSize="11" Margin="3,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="C" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OhlcCloseText" Text="—" FontSize="11" Margin="3,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <wv2:WebView2 Grid.Row="1" x:Name="ChartWebView"/>

                <!-- License requirement: visible attribution link to tradingview.com -->
                <TextBlock Grid.Row="2" Margin="10,2,0,4" FontSize="10"
                           Foreground="{StaticResource TextMuted}">
                    <Hyperlink NavigateUri="https://www.tradingview.com"
                               RequestNavigate="TradingViewLink_RequestNavigate"
                               Foreground="{StaticResource TextMuted}"
                               TextDecorations="None">Chart powered by TradingView Lightweight Charts</Hyperlink>
                </TextBlock>
            </Grid>

            <!-- Stat cards -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="14">
                <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Active strategies" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock x:Name="ActiveStrategiesText" Text="0" Foreground="White" FontSize="18" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,8" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Win rate (backtest)" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock x:Name="WinRateText" Text="—" Foreground="White" FontSize="18" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBg}" CornerRadius="6" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="Signals found" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock x:Name="SignalCountText" Text="—" Foreground="White" FontSize="18" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Right signal panel -->
        <Border Grid.Column="2" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0">
            <DockPanel>
                <TextBlock Text="Active signals" Foreground="{StaticResource TextMuted}" Margin="14,12" DockPanel.Dock="Top"/>
                <ItemsControl x:Name="SignalsList" Margin="0,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="14,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Symbol}" Foreground="White" FontSize="13" FontWeight="Medium"/>
                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,1"
                                                Background="{Binding Type, Converter={StaticResource TypeToBrushConverter}}">
                                            <TextBlock Text="{Binding Type}" FontSize="10" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>