                                    <Button Style="{StaticResource TvButtonLeft}" Tag="gannsquare" Click="ToolButton_Click">
                                        <TextBlock Text="Gann Square" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="gannfan" Click="ToolButton_Click">
                                        <TextBlock Text="Gann Fan" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Shapes group -->
                        <Button x:Name="ShapesGroupButton" Style="{StaticResource RailButton}"
