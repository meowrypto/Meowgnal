<Window x:Class="Meowgnal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Meowgnal.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Meowgnal" Height="600" Width="980"
                WindowStyle="None" Background="{DynamicResource BackgroundBrush}"
        FontFamily="Trebuchet MS"
        FontSize="12"
                PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <views:SignalTypeToBrushConverter x:Key="TypeToBrushConverter"/>
        <views:QualityToBrushConverter x:Key="QualityToBrushConverter"/>
        <!-- Theme brushes: colors come from ThemeService at app level (live switching) -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource ColorBackground}"/>
        <SolidColorBrush x:Key="BgPanel" Color="{DynamicResource ColorPanel}"/>
        <SolidColorBrush x:Key="BorderLine" Color="{DynamicResource ColorBorder}"/>
        <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource ColorTextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource ColorTextSecondary}"/>
        <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource ColorTextMuted}"/>
        <SolidColorBrush x:Key="Accent" Color="{DynamicResource ColorAccent}"/>
        <SolidColorBrush x:Key="Up" Color="{DynamicResource ColorUp}"/>
        <SolidColorBrush x:Key="Down" Color="{DynamicResource ColorDown}"/>

        <!-- Mini chart-type icons -->
        <Canvas x:Key="Icon_candles" x:Shared="False" Width="18" Height="14">
            <Line Canvas.Left="4" Canvas.Top="0" X1="0" Y1="0" X2="0" Y2="14" Stroke="#089981" StrokeThickness="1"/>
            <Rectangle Canvas.Left="2" Canvas.Top="4" Width="5" Height="7" Fill="#089981"/>
            <Line Canvas.Left="12" Canvas.Top="0" X1="0" Y1="0" X2="0" Y2="14" Stroke="#F23645" StrokeThickness="1"/>
            <Rectangle Canvas.Left="10" Canvas.Top="3" Width="5" Height="6" Fill="#F23645"/>
        </Canvas>
        <Canvas x:Key="Icon_bars" x:Shared="False" Width="18" Height="14">
            <Line Canvas.Left="5" Canvas.Top="1" X1="0" Y1="0" X2="0" Y2="12" Stroke="#B2B5BE" StrokeThickness="1.5"/>
            <Line Canvas.Left="2" Canvas.Top="4" X1="0" Y1="0" X2="3" Y2="0" Stroke="#B2B5BE" StrokeThickness="1.5"/>
            <Line Canvas.Left="5" Canvas.Top="9" X1="0" Y1="0" X2="3" Y2="0" Stroke="#B2B5BE" StrokeThickness="1.5"/>
            <Line Canvas.Left="13" Canvas.Top="1" X1="0" Y1="0" X2="0" Y2="12" Stroke="#B2B5BE" StrokeThickness="1.5"/>
            <Line Canvas.Left="10" Canvas.Top="3" X1="0" Y1="0" X2="3" Y2="0" Stroke="#B2B5BE" StrokeThickness="1.5"/>
            <Line Canvas.Left="13" Canvas.Top="9" X1="0" Y1="0" X2="3" Y2="0" Stroke="#B2B5BE" StrokeThickness="1.5"/>
        </Canvas>
        <Canvas x:Key="Icon_line" x:Shared="False" Width="18" Height="14">
            <Polyline Points="0,10 5,4 9,8 13,2 18,6" Stroke="#2962FF" StrokeThickness="1.5" Fill="Transparent"/>
        </Canvas>
        <Canvas x:Key="Icon_area" x:Shared="False" Width="18" Height="14">
            <Polygon Points="0,10 5,4 9,8 13,2 18,6 18,14 0,14" Fill="#2962FF" Opacity="0.3"/>
            <Polyline Points="0,10 5,4 9,8 13,2 18,6" Stroke="#2962FF" StrokeThickness="1.5"/>
        </Canvas>
        <Canvas x:Key="Icon_heikinashi" x:Shared="False" Width="18" Height="14">
            <Line Canvas.Left="4" Canvas.Top="1" X1="0" Y1="0" X2="0" Y2="13" Stroke="#089981" StrokeThickness="1"/>
            <Rectangle Canvas.Left="2" Canvas.Top="5" Width="5" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="#089981"/>
            <Line Canvas.Left="12" Canvas.Top="0" X1="0" Y1="0" X2="0" Y2="13" Stroke="#089981" StrokeThickness="1"/>
            <Rectangle Canvas.Left="10" Canvas.Top="2" Width="5" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="#089981"/>
        </Canvas>

        <!-- Drawing tool icons (TradingView style) -->
        <Canvas x:Key="Icon_cursor" x:Shared="False" Width="18" Height="18">
            <Path Data="M5,2 L5,15 L8.5,11.5 L11,16.5 L13,15.5 L10.5,10.5 L15,10.5 Z" Fill="#B2B5BE"/>
        </Canvas>
        <Canvas x:Key="Icon_hline" x:Shared="False" Width="18" Height="18">
            <Line X1="1" Y1="9" X2="17" Y2="9" Stroke="#B2B5BE" StrokeThickness="1.5"/>
            <Ellipse Canvas.Left="7" Canvas.Top="7" Width="4" Height="4" Fill="#B2B5BE"/>
        </Canvas>
        <Canvas x:Key="Icon_trend" x:Shared="False" Width="18" Height="18">
            <Line X1="3" Y1="15" X2="15" Y2="3" Stroke="#B2B5BE" StrokeThickness="1.5"/>
            <Ellipse Canvas.Left="1" Canvas.Top="13" Width="4" Height="4" Fill="#B2B5BE"/>
            <Ellipse Canvas.Left="13" Canvas.Top="1" Width="4" Height="4" Fill="#B2B5BE"/>
        </Canvas>
        <Canvas x:Key="Icon_fib" x:Shared="False" Width="18" Height="18">
            <Line X1="1" Y1="2" X2="17" Y2="2" Stroke="#B2B5BE" StrokeThickness="1.2"/>
            <Line X1="1" Y1="7" X2="17" Y2="7" Stroke="#B2B5BE" StrokeThickness="1.2"/>
            <Line X1="1" Y1="11" X2="17" Y2="11" Stroke="#B2B5BE" StrokeThickness="1.2"/>
            <Line X1="1" Y1="16" X2="17" Y2="16" Stroke="#B2B5BE" StrokeThickness="1.2"/>
        </Canvas>
        <Canvas x:Key="Icon_autosr" x:Shared="False" Width="18" Height="18">
            <Path Data="M9,1 L10.5,6.5 L16,8 L10.5,9.5 L9,15 L7.5,9.5 L2,8 L7.5,6.5 Z" Fill="#B2B5BE"/>
            <Ellipse Canvas.Left="13" Canvas.Top="12" Width="3" Height="3" Fill="#B2B5BE"/>
        </Canvas>
        <Canvas x:Key="Icon_objects" x:Shared="False" Width="18" Height="18">
            <Line X1="4" Y1="13" X2="14" Y2="5" Stroke="#B2B5BE" StrokeThickness="1.5"/>
            <Rectangle Canvas.Left="1" Canvas.Top="11" Width="5" Height="5" Fill="#B2B5BE"/>
            <Rectangle Canvas.Left="12" Canvas.Top="2" Width="5" Height="5" Fill="#B2B5BE"/>
        </Canvas>
        <Canvas x:Key="Icon_trash" x:Shared="False" Width="18" Height="18">
            <Line X1="3" Y1="4" X2="15" Y2="4" Stroke="#B2B5BE" StrokeThickness="1.5"/>
            <Line X1="7" Y1="2" X2="11" Y2="2" Stroke="#B2B5BE" StrokeThickness="1.5"/>
            <Path Data="M4,6 L5,16 L13,16 L14,6" Stroke="#B2B5BE" StrokeThickness="1.5" Fill="Transparent"/>
            <Line X1="7.5" Y1="8" X2="7.5" Y2="14" Stroke="#B2B5BE" StrokeThickness="1.2"/>
            <Line X1="10.5" Y1="8" X2="10.5" Y2="14" Stroke="#B2B5BE" StrokeThickness="1.2"/>
        </Canvas>
        <Canvas x:Key="Icon_gann" x:Shared="False" Width="18" Height="18">
            <Rectangle Canvas.Left="2" Canvas.Top="2" Width="14" Height="14" Stroke="#B2B5BE" StrokeThickness="1.2" Fill="Transparent"/>
            <Line X1="9" Y1="2" X2="9" Y2="16" Stroke="#B2B5BE" StrokeThickness="1"/>
            <Line X1="2" Y1="9" X2="16" Y2="9" Stroke="#B2B5BE" StrokeThickness="1"/>
        </Canvas>
        <Canvas x:Key="Icon_shapes" x:Shared="False" Width="18" Height="18">
            <Rectangle Canvas.Left="1" Canvas.Top="1" Width="8" Height="8" Stroke="#B2B5BE" StrokeThickness="1.2" Fill="Transparent"/>
            <Ellipse Canvas.Left="9" Canvas.Top="9" Width="8" Height="8" Stroke="#B2B5BE" StrokeThickness="1.2" Fill="Transparent"/>
        </Canvas>
        <Canvas x:Key="Icon_brush" x:Shared="False" Width="18" Height="18">
            <Path Data="M3,15 L8,10 L10,12 L5,17 Z" Fill="#B2B5BE"/>
            <Line X1="8" Y1="10" X2="15" Y2="3" Stroke="#B2B5BE" StrokeThickness="1.5"/>
        </Canvas>
        <Canvas x:Key="Icon_annot" x:Shared="False" Width="18" Height="18">
            <Path Data="M3,14 L4,10 L11,3 L14,6 L7,13 Z" Fill="#B2B5BE"/>
            <Line X1="3" Y1="16" X2="15" Y2="16" Stroke="#B2B5BE" StrokeThickness="1.2"/>
        </Canvas>
        <!-- Window Control Buttons -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#363A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#363A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#363A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TvButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2E39"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TvButtonLeft" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2E39"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="—" Width="46" Height="32" Style="{StaticResource WindowControlButton}" Click="Minimize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaximizeButton" Content="⛶" Width="46" Height="32" Style="{StaticResource WindowControlButton}" Click="Maximize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Width="46" Height="32" Style="{StaticResource CloseButton}" Click="Close_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ProfileButton" Style="{StaticResource ProfileMenuButton}" Click="ProfileButton_Click" Margin="10,0,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ProfileAvatarText" Text="🐱" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Height="20" Fill="{DynamicResource BorderLine}" Margin="12,0,12,0"/>

                        <TextBlock Text="🐱" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Meowgnal" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock x:Name="TitleBarVersion" Text="" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Profile Menu Popup -->
            <Popup x:Name="ProfilePopup" StaysOpen="False" AllowsTransparency="True"
                   Placement="Bottom" PlacementTarget="{Binding ElementName=ProfileButton}">
                <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                        BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,4,0,0" Width="240">
                    <StackPanel>
                        <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="4" Padding="12" Margin="4,4,4,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="MenuAvatarText" Text="🐱" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="MenuNameText" Text="Guest" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock x:Name="MenuStatusText" Text="Demo" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource TvButtonLeft}" Content="⚙  App settings" Click="MenuSettings_Click"/>
                        <Button Style="{StaticResource TvButtonLeft}" Content="🔑  Activate license" Click="MenuLicense_Click"/>
                        <Border Height="1" Background="{DynamicResource BorderLine}" Margin="4,4"/>
                        <Button Style="{StaticResource TvButtonLeft}" Content="❓  Help Center" Click="MenuHelp_Click"/>
                        <Button Style="{StaticResource TvButtonLeft}" Content="✨  What's new" Click="MenuWhatsNew_Click"/>
                        <Border Height="1" Background="{DynamicResource BorderLine}" Margin="4,4"/>
                        <Button Style="{StaticResource TvButtonLeft}" Content="🌙  Dark theme" Click="ThemeDark_Click"/>
                        <Button Style="{StaticResource TvButtonLeft}" Content="☀️  Light theme" Click="ThemeLight_Click"/>
                        <Button Style="{StaticResource TvButtonLeft}" Content="🖥️  Match Windows" Click="ThemeSystem_Click"/>
                        <Button Style="{StaticResource TvButtonLeft}" Content="🎨  Custom colors…" Click="ThemeCustom_Click"/>
                        <Border Height="1" Background="{DynamicResource BorderLine}" Margin="4,4"/>
                        <Button Style="{StaticResource TvButtonLeft}" Content="🚪  Sign out / Switch profile" Click="MenuSignOut_Click" Foreground="{DynamicResource Down}"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Original Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <!-- Left tool rail -->
                <Border Grid.Column="0" Background="{DynamicResource BgPanel}"
                        BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">
                        <!-- Cursor group -->
                        <Button x:Name="CursorGroupButton" Style="{StaticResource RailButton}"
                                Click="CursorGroup_Click" ToolTip="Cursor tools">
                            <ContentControl Content="{StaticResource Icon_cursor}" Width="18" Height="18"/>
                        </Button>
                        <Popup x:Name="CursorPopup" StaysOpen="False" AllowsTransparency="True"
                               Placement="Right" PlacementTarget="{Binding ElementName=CursorGroupButton}">
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                    BorderThickness="1" CornerRadius="4" Padding="4" Margin="4,0,0,0">
                                <StackPanel>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="cursor" Click="ToolButton_Click">
                                        <TextBlock Text="Cross" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="dot" Click="ToolButton_Click">
                                        <TextBlock Text="Dot" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="arrow" Click="ToolButton_Click">
                                        <TextBlock Text="Arrow" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="eraser" Click="ToolButton_Click">
                                        <TextBlock Text="Eraser (click a drawing)" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Line tools group -->
                        <Button x:Name="LineGroupButton" Style="{StaticResource RailButton}"
                                Click="LineGroup_Click" ToolTip="Line tools">
                            <ContentControl Content="{StaticResource Icon_trend}" Width="18" Height="18"/>
                        </Button>
                        <Popup x:Name="LinePopup" StaysOpen="False" AllowsTransparency="True"
                               Placement="Right" PlacementTarget="{Binding ElementName=LineGroupButton}">
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                    BorderThickness="1" CornerRadius="4" Padding="4" Margin="4,0,0,0">
                                <StackPanel>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="trendline" Click="ToolButton_Click">
                                        <TextBlock Text="Trend Line (2 clicks)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="ray" Click="ToolButton_Click">
                                        <TextBlock Text="Ray" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="extendedline" Click="ToolButton_Click">
                                        <TextBlock Text="Extended Line" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="horizontal" Click="ToolButton_Click">
                                        <TextBlock Text="Horizontal Line" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="horizontalray" Click="ToolButton_Click">
                                        <TextBlock Text="Horizontal Ray" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="verticalline" Click="ToolButton_Click">
                                        <TextBlock Text="Vertical Line" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="crossline" Click="ToolButton_Click">
                                        <TextBlock Text="Cross Line" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="infoline" Click="ToolButton_Click">
                                        <TextBlock Text="Info Line (% change)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="trendangle" Click="ToolButton_Click">
                                        <TextBlock Text="Trend Angle" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Channel tools group -->
                        <Button x:Name="ChannelGroupButton" Style="{StaticResource RailButton}"
                                Click="ChannelGroup_Click" ToolTip="Channel and pitchfork tools">
                            <ContentControl Content="{StaticResource Icon_hline}" Width="18" Height="18"/>
                        </Button>
                        <Popup x:Name="ChannelPopup" StaysOpen="False" AllowsTransparency="True"
                               Placement="Right" PlacementTarget="{Binding ElementName=ChannelGroupButton}">
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                    BorderThickness="1" CornerRadius="4" Padding="4" Margin="4,0,0,0">
                                <StackPanel>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="parallelchannel" Click="ToolButton_Click">
                                        <TextBlock Text="Parallel Channel (3 clicks)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="regressiontrend" Click="ToolButton_Click">
                                        <TextBlock Text="Regression Trend" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="flattopbottom" Click="ToolButton_Click">
                                        <TextBlock Text="Flat Top/Bottom (3 clicks)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="disjointchannel" Click="ToolButton_Click">
                                        <TextBlock Text="Disjoint Channel (4 clicks)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Border Height="1" Background="{DynamicResource BorderLine}" Margin="4,4"/>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="pitchfork" Click="ToolButton_Click">
                                        <TextBlock Text="Pitchfork (3 clicks)" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="schiffpitchfork" Click="ToolButton_Click">
                                        <TextBlock Text="Schiff Pitchfork" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="modifiedschiffpitchfork" Click="ToolButton_Click">
                                        <TextBlock Text="Modified Schiff" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource TvButtonLeft}" Tag="insidepitchfork" Click="ToolButton_Click">
                                        <TextBlock Text="Inside Pitchfork" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Fibonacci group -->
                        <Button x:Name="FibGroupButton" Style="{StaticResource RailButton}"
                                Click="FibGroup_Click" ToolTip="Fibonacci tools">
                            <ContentControl Content="{StaticResource Icon_fib}" Width="18" Height="18"/>
                        </Button>
                        <Popup x:Name="FibPopup" StaysOpen="False" AllowsTransparency="True"
                               Placement="Right" PlacementTarget="{Binding ElementName=FibGroupButton}">
                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderLine}"
                                    BorderThickness="1" CornerRadius="4" Padding="4" Margin="4,0,0,0">
                                <StackPanel>
